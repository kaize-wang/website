---
import '@/styles/global.css';
import '@/styles/interaction.css';
import '@/styles/advanced-tools.css';
import '@/styles/information-architecture.css';
import UiLanguageToggle from '@/components/UiLanguageToggle.astro';
import { site } from '@/site.config';
import { getPublishedNotes, noteSlug } from '@/utils/notes';
import { withBase } from '@/utils/url';
const { title = site.title, description = site.shortBio, active = '' } = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;

const rawBase = import.meta.env.BASE_URL || '/';
const basePrefix = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
let routePath = Astro.url.pathname;
if (basePrefix && routePath.startsWith(basePrefix)) routePath = routePath.slice(basePrefix.length);
routePath = routePath.replace(/\/+$/, '') || '/';

const isHome = routePath === '/';
const isArticle = routePath.startsWith('/notes/');
const isResearchContext = routePath === '/research' || routePath === '/questions' || routePath === '/sandbox';
const isNotesBrowse =
  routePath === '/notes' ||
  isArticle ||
  routePath.startsWith('/tags/') ||
  routePath.startsWith('/categories/') ||
  routePath.startsWith('/collections/');
const isNotesContext =
  isNotesBrowse ||
  routePath === '/archive' ||
  routePath === '/graph' ||
  routePath === '/papers' ||
  routePath === '/literature';

const researchNav = [
  { label: 'Overview', href: '/research', active: routePath === '/research' },
  { label: 'Questions', href: '/questions', active: routePath === '/questions' },
  { label: 'Sandbox', href: '/sandbox', active: routePath === '/sandbox' }
];
const notesNav = [
  { label: 'All Notes', href: '/notes', active: isNotesBrowse },
  { label: 'Paper Reading', href: '/papers', active: routePath === '/papers' },
  { label: 'Knowledge Graph', href: '/graph', active: routePath === '/graph' },
  { label: 'Literature Map', href: '/literature', active: routePath === '/literature' },
  { label: 'Archive', href: '/archive', active: routePath === '/archive' }
];
const contextualNav = isResearchContext ? researchNav : isNotesContext ? notesNav : [];
const contextualLabel = isResearchContext ? 'Research' : isNotesContext ? 'Notes' : '';
const contextBack = isHome
  ? null
  : isArticle
    ? { label: 'Notes', href: '/notes' }
    : routePath === '/research' || routePath === '/notes' || routePath === '/about' || routePath === '/search'
      ? { label: 'Home', href: '/' }
      : isResearchContext
        ? { label: 'Research', href: '/research' }
        : isNotesContext
          ? { label: 'Notes', href: '/notes' }
          : { label: 'Home', href: '/' };

const navZh: Record<string, string> = {
  Home: '首页',
  Research: '研究',
  Notes: '笔记',
  About: '关于',
  Search: '搜索'
};
const commandNotes = await getPublishedNotes();
const commandItems = [
  ...site.nav.map(item => ({
    type: 'Page',
    typeZh: '页面',
    title: item.label,
    titleZh: navZh[item.label] || item.label,
    description: item.label === 'Home' ? site.shortBio : `Open ${item.label}`,
    descriptionZh: item.label === 'Home' ? site.shortBio : `打开${navZh[item.label] || item.label}`,
    href: withBase(item.href),
    keywords: `${item.label} ${navZh[item.label] || ''}`
  })),
  {
    type: 'Map',
    typeZh: '图谱',
    title: 'Knowledge Graph',
    titleZh: '知识图谱',
    description: 'Time machine, shortest paths, backlinks, constellation, and serendipity.',
    descriptionZh: '时间机器、最短路径、反向链接、星图与随机联想。',
    href: withBase('/graph'),
    keywords: 'graph knowledge wiki backlinks network notes timeline time machine shortest path constellation serendipity 知识图谱 时间 路径 星图'
  },
  {
    type: 'Papers',
    typeZh: '论文',
    title: 'Paper Reading',
    titleZh: '论文阅读',
    description: 'Literature reading dashboard with local revisit scheduling.',
    descriptionZh: '论文阅读工作台与本地重读计划。',
    href: withBase('/papers'),
    keywords: 'papers literature reading dashboard research revisit spaced repetition 论文 阅读 重读'
  },
  {
    type: 'Map',
    typeZh: '图谱',
    title: 'Literature Map',
    titleZh: '文献图谱',
    description: 'Explore reading notes, papers, and explicitly recorded references.',
    descriptionZh: '查看阅读笔记、论文与明确记录的参考关系。',
    href: withBase('/literature'),
    keywords: 'literature citations references papers map network 文献 图谱 引用'
  },
  {
    type: 'Research',
    typeZh: '研究',
    title: 'Questions Board',
    titleZh: '研究问题',
    description: 'Track explicitly recorded open, exploring, reframed, and resolved questions.',
    descriptionZh: '追踪明确记录的开放、探索、重构与已解决问题。',
    href: withBase('/questions'),
    keywords: 'research questions open exploring resolved board 研究 问题'
  },
  {
    type: 'Research',
    typeZh: '研究',
    title: 'Research Sandbox',
    titleZh: '研究沙盒',
    description: 'Open small interactive sketches for mechanism intuition.',
    descriptionZh: '用于机制直觉的小型交互草图。',
    href: withBase('/sandbox'),
    keywords: 'research sandbox intuition interactive toy warranty playground 研究 沙盒 直觉'
  },
  ...commandNotes.map(note => ({
    type: 'Note',
    typeZh: '笔记',
    title: note.data.title,
    titleZh: note.data.title,
    description: note.data.description,
    descriptionZh: note.data.description,
    href: withBase(`/notes/${noteSlug(note.id)}/`),
    keywords: [
      note.data.category,
      note.data.collection,
      note.data.paper?.title,
      ...(note.data.paper?.authors || []),
      note.data.readingStatus,
      ...note.data.tags,
      ...note.data.aliases,
      ...(note.data.researchQuestions || []).map(question => question.text)
    ].filter(Boolean).join(' ')
  }))
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && dark)) document.documentElement.dataset.theme = 'dark';
        const savedUiLanguage = localStorage.getItem('kaize-ui-language');
        document.documentElement.dataset.uiLanguage = savedUiLanguage === 'zh' ? 'zh' : 'en';
        document.documentElement.lang = savedUiLanguage === 'zh' ? 'zh-CN' : 'en';
      } catch {
        document.documentElement.dataset.uiLanguage = 'en';
      }
    </script>
  </head>
  <body>
    <div class="site-frame">
      <aside class="site-sidebar">
        <div class="sidebar-inner">
          <div class="sidebar-identity">
            <a class="brand" href={withBase('/')} aria-label="Go to homepage">{site.title}</a>
            <p class="sidebar-caption">Academic homepage</p>
          </div>

          <nav class="sidebar-nav" aria-label="Main navigation">
            {site.nav.map(item => (
              <a
                class={active === item.label ? 'active' : ''}
                href={withBase(item.href)}
                aria-current={active === item.label ? 'page' : undefined}
              >
                <span>{item.label}</span>
              </a>
            ))}
          </nav>

          {contextualNav.length > 0 && (
            <div class="sidebar-context">
              <span class="sidebar-context-label">{contextualLabel}</span>
              <nav class="sidebar-context-nav" aria-label={`${contextualLabel} sections`}>
                {contextualNav.map(item => (
                  <a class={item.active ? 'active' : ''} href={withBase(item.href)} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </nav>
            </div>
          )}

          <button class="sidebar-command" id="command-trigger" type="button" aria-haspopup="dialog" aria-controls="command-palette" aria-expanded="false">
            <span>Quick search</span><kbd id="command-shortcut">⌘K</kbd>
          </button>

          <div class="sidebar-bottom">
            <span class="sidebar-small">Research · Notes · Writing</span>
            <div class="sidebar-settings">
              <UiLanguageToggle />
              <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle light and dark theme">◐</button>
            </div>
          </div>
        </div>
      </aside>

      <div class="site-main">
        {isArticle && <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>}
        {contextBack && (
          <div class="context-nav-wrap">
            <nav class="context-nav" aria-label="Back navigation">
              <a href={withBase(contextBack.href)}>← Back to {contextBack.label}</a>
            </nav>
          </div>
        )}
        <slot />
        <footer class="site-footer">
          <div class="site-shell footer-inner">
            <span>© {new Date().getFullYear()} {site.fullName}</span>
            <span>Built with Astro · writing stays in Markdown</span>
          </div>
        </footer>
      </div>
    </div>

    <button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top" title="Back to top">↑</button>

    <div class="command-palette" id="command-palette" hidden>
      <div class="command-panel" role="dialog" aria-modal="true" aria-labelledby="command-title">
        <div class="command-heading">
          <span id="command-title">Search kaizewang</span>
          <div class="command-heading-actions">
            <kbd>Esc</kbd>
            <button class="command-close" id="command-close" type="button" aria-label="Close search" title="Close search">×</button>
          </div>
        </div>
        <label class="command-input-wrap" for="command-input">
          <span aria-hidden="true">⌕</span>
          <input id="command-input" type="search" autocomplete="off" spellcheck="false" placeholder="Search pages, notes, papers, graph…" />
        </label>
        <nav class="command-results" id="command-results" aria-label="Search results"></nav>
        <div class="command-help"><span>↑ ↓ navigate</span><span>↵ open</span></div>
      </div>
    </div>

    <script is:inline define:vars={{ commandItems }}>
      (() => {
        const shortcut = document.getElementById('command-shortcut');
        if (shortcut) shortcut.textContent = /Mac|iPhone|iPad/i.test(navigator.platform || '') ? '⌘K' : 'Ctrl K';

        const themeToggle = document.getElementById('theme-toggle');
        themeToggle?.addEventListener('click', () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          document.documentElement.dataset.theme = isDark ? '' : 'dark';
          localStorage.setItem('theme', isDark ? 'light' : 'dark');
        });

        const palette = document.getElementById('command-palette');
        const trigger = document.getElementById('command-trigger');
        const closeButton = document.getElementById('command-close');
        const input = document.getElementById('command-input');
        const results = document.getElementById('command-results');
        let filtered = commandItems.slice();
        let selected = 0;
        let lastFocused = null;

        const normalize = value => String(value || '').toLowerCase();
        const uiLanguage = () => window.__kaizeUi?.language === 'zh' ? 'zh' : 'en';
        const uiValue = (item, key) => uiLanguage() === 'zh' ? (item[`${key}Zh`] || item[key]) : item[key];

        function syncSelection() {
          const links = [...results.querySelectorAll('a')];
          links.forEach((link, index) => {
            const active = index === selected;
            link.classList.toggle('selected', active);
            link.setAttribute('aria-current', active ? 'true' : 'false');
          });
          links[selected]?.scrollIntoView({ block: 'nearest' });
        }

        function renderResults(query = '') {
          const q = normalize(query.trim());
          filtered = commandItems.filter(item => {
            if (!q) return true;
            return normalize([item.title, item.titleZh, item.description, item.descriptionZh, item.keywords, item.type, item.typeZh].join(' ')).includes(q);
          }).slice(0, 9);
          selected = 0;
          results.replaceChildren();

          if (!filtered.length) {
            const empty = document.createElement('p');
            empty.className = 'command-empty';
            empty.textContent = window.__kaizeUi?.t('No matching pages or notes.', '没有匹配的页面或笔记。') || 'No matching pages or notes.';
            results.appendChild(empty);
            return;
          }

          filtered.forEach((item, index) => {
            const link = document.createElement('a');
            link.href = item.href;
            link.className = 'command-result';
            link.dataset.index = String(index);

            const copy = document.createElement('span');
            copy.className = 'command-result-copy';
            const title = document.createElement('strong');
            title.textContent = uiValue(item, 'title');
            const desc = document.createElement('small');
            desc.textContent = uiValue(item, 'description') || item.keywords || '';
            copy.append(title, desc);

            const type = document.createElement('span');
            type.className = 'command-result-type';
            type.textContent = uiValue(item, 'type');
            link.append(copy, type);
            link.addEventListener('mouseenter', () => {
              selected = index;
              syncSelection();
            });
            link.addEventListener('click', closePalette);
            results.appendChild(link);
          });
          syncSelection();
        }

        function openPalette() {
          if (!palette || !input) return;
          lastFocused = document.activeElement;
          palette.hidden = false;
          trigger?.setAttribute('aria-expanded', 'true');
          document.body.classList.add('palette-open');
          input.value = '';
          renderResults();
          requestAnimationFrame(() => input.focus());
        }

        function closePalette() {
          if (!palette) return;
          palette.hidden = true;
          trigger?.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('palette-open');
          if (lastFocused instanceof HTMLElement) lastFocused.focus();
        }

        trigger?.addEventListener('click', openPalette);
        closeButton?.addEventListener('click', closePalette);
        palette?.addEventListener('click', event => {
          if (event.target === palette) closePalette();
        });
        input?.addEventListener('input', event => renderResults(event.target.value));
        input?.addEventListener('keydown', event => {
          if (event.key === 'ArrowDown' && filtered.length) {
            event.preventDefault();
            selected = (selected + 1) % filtered.length;
            syncSelection();
          } else if (event.key === 'ArrowUp' && filtered.length) {
            event.preventDefault();
            selected = (selected - 1 + filtered.length) % filtered.length;
            syncSelection();
          } else if (event.key === 'Enter' && filtered.length) {
            event.preventDefault();
            results.querySelectorAll('a')[selected]?.click();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            closePalette();
          }
        });
        document.addEventListener('kaize:ui-language', () => {
          if (input) renderResults(input.value);
        });

        document.addEventListener('keydown', event => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            palette?.hidden ? openPalette() : closePalette();
          } else if (event.key === 'Escape' && palette && !palette.hidden) {
            event.preventDefault();
            closePalette();
          }
        });

        const backToTop = document.getElementById('back-to-top');
        const progress = document.getElementById('reading-progress-bar');
        const tocLinks = [...document.querySelectorAll('[data-floating-toc] a[href^="#"]')];
        const tocSections = tocLinks.map(link => {
          const id = decodeURIComponent(link.hash.slice(1));
          return { link, section: document.getElementById(id) };
        }).filter(item => item.section);
        let ticking = false;

        function updateScrollUI() {
          const y = window.scrollY;
          backToTop?.classList.toggle('visible', y > 520);

          if (progress) {
            const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
            const ratio = Math.min(1, Math.max(0, y / max));
            progress.style.transform = `scaleX(${ratio})`;
          }

          if (tocSections.length) {
            let current = tocSections[0];
            for (const item of tocSections) {
              if (item.section.getBoundingClientRect().top <= 150) current = item;
              else break;
            }
            tocSections.forEach(item => {
              const active = item === current;
              item.link.classList.toggle('active', active);
              if (active) item.link.setAttribute('aria-current', 'location');
              else item.link.removeAttribute('aria-current');
            });
          }
          ticking = false;
        }

        function requestScrollUpdate() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateScrollUI);
        }

        backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        window.addEventListener('scroll', requestScrollUpdate, { passive: true });
        window.addEventListener('resize', requestScrollUpdate);
        updateScrollUI();
      })();
    </script>
  </body>
</html>