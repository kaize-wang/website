---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import '@/styles/ideas.css';
import '@/styles/ideas-v3.css';
import { withBase } from '@/utils/url';

const ideas = (await getCollection('ideas', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.createdDate).valueOf() - (a.data.updatedDate ?? a.data.createdDate).valueOf());

const seedIdeas = ideas.map(idea => ({
  id: idea.id,
  href: withBase(`/ideas/${idea.id}/`),
  title: idea.data.title,
  titleZh: idea.data.titleZh || idea.data.title,
  summary: idea.data.summary,
  summaryZh: idea.data.summaryZh || idea.data.summary,
  area: idea.data.area,
  stage: idea.data.stage,
  createdDate: idea.data.createdDate.toISOString(),
  updatedDate: (idea.data.updatedDate ?? idea.data.createdDate).toISOString(),
  nextAction: idea.data.nextAction || '',
  nextActionZh: idea.data.nextActionZh || idea.data.nextAction || '',
  whyNow: idea.data.whyNow || '',
  whyNowZh: idea.data.whyNowZh || idea.data.whyNow || '',
  milestones: idea.data.milestones.map(item => ({ text: item.text, textZh: item.textZh || item.text, done: item.done })),
  progress: idea.data.progress.map(item => ({ date: item.date.toISOString(), note: item.note, noteZh: item.noteZh || item.note })),
  tags: idea.data.tags
}));
---

<BaseLayout title="Ideas" active="Ideas">
  <main class="site-shell ideas-studio ideas-studio-v3">
    <header class="ideas-studio-hero">
      <div class="ideas-studio-heading">
        <div class="eyebrow"><span class="ui-copy-en">Ideas · working studio</span><span class="ui-copy-zh">想法 · 工作台</span></div>
        <h1><span class="ui-copy-en">Ideas</span><span class="ui-copy-zh">想法</span></h1>
        <p>
          <span class="ui-copy-en">Capture quickly. Develop deliberately. Keep the next move visible.</span>
          <span class="ui-copy-zh">先快速接住念头，再认真发展，并始终看得见下一步。</span>
        </p>
      </div>
      <button class="studio-capture-button" id="idea-capture-trigger" type="button">
        <span class="studio-capture-plus">+</span>
        <span><span class="ui-copy-en">Capture</span><span class="ui-copy-zh">记下想法</span></span>
        <kbd>C</kbd>
      </button>
    </header>

    <nav class="idea-view-switcher" aria-label="Ideas views">
      <button class="idea-view-tab active" type="button" data-idea-view="cockpit" aria-pressed="true"><span class="ui-copy-en">Cockpit</span><span class="ui-copy-zh">控制台</span></button>
      <button class="idea-view-tab" type="button" data-idea-view="board" aria-pressed="false"><span class="ui-copy-en">Board</span><span class="ui-copy-zh">推进板</span></button>
      <button class="idea-view-tab" type="button" data-idea-view="library" aria-pressed="false"><span class="ui-copy-en">Library</span><span class="ui-copy-zh">资料库</span></button>
      <span class="idea-view-status" id="idea-view-status"></span>
    </nav>

    <section class="idea-view-panel active" id="idea-view-cockpit" data-idea-view-panel="cockpit">
      <section class="idea-flow-panel" aria-labelledby="idea-flow-title">
        <div class="idea-flow-copy">
          <span class="studio-section-kicker"><span class="ui-copy-en">Idea flow</span><span class="ui-copy-zh">想法流</span></span>
          <h2 id="idea-flow-title"><span class="ui-copy-en">From a spark to something real.</span><span class="ui-copy-zh">从一闪而过，到真正落地。</span></h2>
          <p><span class="ui-copy-en">A quiet overview of where your attention is accumulating. Click a stage to open it on the Board.</span><span class="ui-copy-zh">一眼看出注意力正堆积在哪里。点击任一阶段，可直接在推进板中查看。</span></p>
        </div>
        <div class="idea-flow-visual" id="idea-flow-visual" aria-live="polite"></div>
      </section>

      <div class="cockpit-grid">
        <section class="cockpit-motion" aria-labelledby="motion-title">
          <div class="studio-section-head">
            <div>
              <span class="studio-section-kicker"><span class="ui-copy-en">Now</span><span class="ui-copy-zh">现在</span></span>
              <h2 id="motion-title"><span class="ui-copy-en">In motion</span><span class="ui-copy-zh">正在推进</span></h2>
            </div>
            <span class="studio-section-note"><span class="ui-copy-en">Keep this list short.</span><span class="ui-copy-zh">这里应该始终很短。</span></span>
          </div>
          <div class="motion-list" id="idea-motion-list"></div>
        </section>

        <aside class="cockpit-inbox" aria-labelledby="inbox-title">
          <div class="studio-section-head is-compact">
            <div>
              <span class="studio-section-kicker"><span class="ui-copy-en">Local only</span><span class="ui-copy-zh">仅本机</span></span>
              <h2 id="inbox-title"><span class="ui-copy-en">Private Inbox</span><span class="ui-copy-zh">私人收件箱</span></h2>
            </div>
            <button class="studio-inline-action" id="idea-inbox-capture" type="button" aria-label="Capture an idea">+</button>
          </div>
          <p class="cockpit-inbox-intro"><span class="ui-copy-en">Rough thoughts land here first. No category or status required.</span><span class="ui-copy-zh">粗糙念头先落在这里，不要求分类，也不要求状态。</span></p>
          <div class="cockpit-inbox-list" id="idea-inbox-list"></div>
          <button class="inbox-empty-capture" id="idea-empty-capture" type="button" hidden><span class="ui-copy-en">+ Capture the first thought</span><span class="ui-copy-zh">+ 记下第一个念头</span></button>
        </aside>
      </div>

      <section class="resurface-strip" id="idea-resurface" aria-labelledby="resurface-title">
        <div class="resurface-label">
          <span class="studio-section-kicker"><span class="ui-copy-en">Resurface</span><span class="ui-copy-zh">重新浮现</span></span>
          <h2 id="resurface-title"><span class="ui-copy-en">Worth another look?</span><span class="ui-copy-zh">这个还值得再看一眼吗？</span></h2>
        </div>
        <div class="resurface-content" id="idea-resurface-content"></div>
      </section>
    </section>

    <section class="idea-view-panel" id="idea-view-board" data-idea-view-panel="board" hidden>
      <div class="board-intro">
        <div>
          <span class="studio-section-kicker"><span class="ui-copy-en">Working state</span><span class="ui-copy-zh">工作状态</span></span>
          <h2><span class="ui-copy-en">Move an idea when your intention changes.</span><span class="ui-copy-zh">当你的意图改变，就直接移动这个想法。</span></h2>
        </div>
        <p><span class="ui-copy-en">Drag on desktop, or change stage from Peek on touch devices. Every move stays local to this browser.</span><span class="ui-copy-zh">桌面端可直接拖动；触屏设备可在 Peek 中改状态。所有移动只保存在当前浏览器。</span></p>
      </div>

      <div class="board-scroll" id="idea-board-scroll" tabindex="0">
        <div class="idea-board" id="idea-board">
          <section class="board-lane" data-board-lane="Spark">
            <header><span class="board-lane-index">01</span><h3><span class="ui-copy-en">Sparks</span><span class="ui-copy-zh">灵感池</span></h3><strong data-lane-count="Spark">0</strong></header>
            <p><span class="ui-copy-en">Captured, not committed.</span><span class="ui-copy-zh">已经记下，还没有承诺。</span></p>
            <div class="board-dropzone" data-drop-stage="Spark"></div>
          </section>
          <section class="board-lane" data-board-lane="Exploring">
            <header><span class="board-lane-index">02</span><h3><span class="ui-copy-en">Explore</span><span class="ui-copy-zh">探索</span></h3><strong data-lane-count="Exploring">0</strong></header>
            <p><span class="ui-copy-en">Interesting enough to think again.</span><span class="ui-copy-zh">值得再想一轮。</span></p>
            <div class="board-dropzone" data-drop-stage="Exploring"></div>
          </section>
          <section class="board-lane" data-board-lane="Active">
            <header><span class="board-lane-index">03</span><h3><span class="ui-copy-en">In motion</span><span class="ui-copy-zh">推进中</span></h3><strong data-lane-count="Active">0</strong></header>
            <p><span class="ui-copy-en">Has a concrete next move.</span><span class="ui-copy-zh">已经有明确下一步。</span></p>
            <div class="board-dropzone" data-drop-stage="Active"></div>
          </section>
          <section class="board-lane" data-board-lane="Realized">
            <header><span class="board-lane-index">04</span><h3><span class="ui-copy-en">Realized</span><span class="ui-copy-zh">已落地</span></h3><strong data-lane-count="Realized">0</strong></header>
            <p><span class="ui-copy-en">Became something real.</span><span class="ui-copy-zh">已经变成真实成果。</span></p>
            <div class="board-dropzone" data-drop-stage="Realized"></div>
          </section>
        </div>
      </div>
      <div class="board-footnote">
        <span><span class="ui-copy-en">Click a card to work on it without leaving the Board.</span><span class="ui-copy-zh">点击卡片即可在不离开推进板的情况下继续处理。</span></span>
        <button id="show-parked" type="button"></button>
      </div>
      <div class="parked-shelf" id="parked-shelf" hidden></div>
    </section>

    <section class="idea-view-panel" id="idea-view-library" data-idea-view-panel="library" hidden>
      <div class="library-head">
        <div>
          <span class="studio-section-kicker"><span class="ui-copy-en">Archive without ceremony</span><span class="ui-copy-zh">不用仪式感的归档</span></span>
          <h2><span class="ui-copy-en">Find an old thought quickly.</span><span class="ui-copy-zh">快速找回以前的念头。</span></h2>
        </div>
        <div class="library-tools">
          <input id="idea-library-search" type="search" autocomplete="off" placeholder="Search ideas…" aria-label="Search ideas" />
          <select id="idea-library-stage" aria-label="Filter by stage"></select>
          <select id="idea-library-area" aria-label="Filter by area"></select>
        </div>
      </div>
      <div class="idea-library-list" id="idea-library-list"></div>
      <div class="library-empty" id="idea-library-empty" hidden></div>
    </section>
  </main>

  <dialog class="quick-capture-dialog" id="idea-capture-dialog">
    <form id="idea-capture-form" method="dialog">
      <div class="quick-capture-head">
        <span><span class="ui-copy-en">Capture before it disappears</span><span class="ui-copy-zh">趁它还没消失，先记下来</span></span>
        <button class="quick-capture-close" id="idea-capture-close" type="button" aria-label="Close">×</button>
      </div>
      <label class="quick-capture-line" for="idea-capture-title">
        <span aria-hidden="true">→</span>
        <input id="idea-capture-title" name="title" required maxlength="160" autocomplete="off" placeholder="One sentence is enough…" />
      </label>
      <details class="quick-capture-more">
        <summary><span class="ui-copy-en">Add context</span><span class="ui-copy-zh">补一点上下文</span></summary>
        <div class="quick-capture-fields">
          <label><span><span class="ui-copy-en">Area</span><span class="ui-copy-zh">领域</span></span><select id="idea-capture-area" name="area"></select></label>
          <label><span><span class="ui-copy-en">Quick note</span><span class="ui-copy-zh">随手记</span></span><textarea id="idea-capture-note" name="note" maxlength="1200" placeholder="Why did this feel worth keeping?"></textarea></label>
        </div>
      </details>
      <div class="quick-capture-foot">
        <small><span class="ui-copy-en">Private · saved only in this browser</span><span class="ui-copy-zh">私密 · 只保存在当前浏览器</span></small>
        <button type="submit"><span class="ui-copy-en">Save to Inbox</span><span class="ui-copy-zh">存入收件箱</span><kbd>Enter</kbd></button>
      </div>
    </form>
  </dialog>

  <div class="idea-peek-backdrop" id="idea-peek-backdrop" hidden></div>
  <aside class="idea-peek" id="idea-peek" aria-hidden="true" aria-label="Idea details"><div class="idea-peek-inner" id="idea-peek-inner"></div></aside>
  <div class="idea-toast" id="idea-toast" role="status" aria-live="polite"></div>
  <SiteExtras />

  <script is:inline define:vars={{ seedIdeas }}>
    (() => {
      const INBOX_KEY = 'kaize-private-idea-inbox-v2';
      const LEGACY_INBOX_KEY = 'kaize-private-idea-inbox-v1';
      const WORKBENCH_KEY = 'kaize-idea-workbench-v2';
      const VIEW_KEY = 'kaize-idea-view-v2';
      const validStages = ['Spark', 'Exploring', 'Active', 'Realized', 'Parked'];
      const stageOrder = ['Spark', 'Exploring', 'Active', 'Realized'];
      const areas = ['Unsorted', 'Research', 'Build', 'Life', 'Writing', 'Learning'];
      const areaZh = { Unsorted:'未分类', Research:'研究', Build:'构建', Life:'生活', Writing:'写作', Learning:'学习' };
      const stageZh = { Spark:'灵感', Exploring:'探索', Active:'推进中', Realized:'已落地', Parked:'已搁置' };
      const stageEn = { Spark:'Spark', Exploring:'Explore', Active:'In motion', Realized:'Realized', Parked:'Parked' };
      const flowLabelEn = { Spark:'Spark', Exploring:'Explore', Active:'In motion', Realized:'Realized' };
      const flowLabelZh = { Spark:'灵感', Exploring:'探索', Active:'推进中', Realized:'已落地' };

      const $ = selector => document.querySelector(selector);
      const $$ = selector => [...document.querySelectorAll(selector)];
      const language = () => window.__kaizeUi?.language === 'zh' ? 'zh' : 'en';
      const t = (en, zh) => language() === 'zh' ? (zh || en) : en;
      const escapeText = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
      const safeGet = key => { try { return localStorage.getItem(key); } catch { return null; } };
      const safeJson = (key, fallback) => { try { const raw = safeGet(key); return raw ? (JSON.parse(raw) ?? fallback) : fallback; } catch { return fallback; } };
      const saveJson = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
      const validDate = value => Number.isFinite(Date.parse(value || ''));
      const nowIso = () => new Date().toISOString();
      const normalizeStage = value => validStages.includes(value) ? value : 'Spark';
      const normalizeArea = value => areas.includes(value) ? value : 'Unsorted';
      const formatDate = value => {
        if (!validDate(value)) return '—';
        try { return new Intl.DateTimeFormat(language() === 'zh' ? 'zh-CN' : 'en', language() === 'zh' ? { month:'numeric', day:'numeric' } : { month:'short', day:'numeric' }).format(new Date(value)); }
        catch { return '—'; }
      };

      const sanitizePrivateIdea = (item, index = 0) => {
        const title = String(item?.title || '').trim();
        if (!title) return null;
        const createdAt = validDate(item?.createdAt) ? item.createdAt : nowIso();
        const updatedAt = validDate(item?.updatedAt) ? item.updatedAt : createdAt;
        const progress = Array.isArray(item?.progress) ? item.progress
          .map(entry => ({ date: validDate(entry?.date || entry?.createdAt) ? (entry.date || entry.createdAt) : updatedAt, note:String(entry?.note || '').trim() }))
          .filter(entry => entry.note) : [];
        return {
          id: String(item?.id || `local-${Date.now()}-${index}`),
          title,
          note: String(item?.note || '').trim(),
          area: normalizeArea(item?.area),
          stage: normalizeStage(item?.stage),
          nextAction: String(item?.nextAction || '').trim(),
          createdAt,
          updatedAt,
          progress
        };
      };

      let privateIdeas = safeJson(INBOX_KEY, null);
      if (!Array.isArray(privateIdeas)) privateIdeas = safeJson(LEGACY_INBOX_KEY, []);
      privateIdeas = (Array.isArray(privateIdeas) ? privateIdeas : []).map(sanitizePrivateIdea).filter(Boolean);
      saveJson(INBOX_KEY, privateIdeas);

      let workbench = safeJson(WORKBENCH_KEY, {});
      if (!workbench || typeof workbench !== 'object' || Array.isArray(workbench)) workbench = {};
      workbench.stage = workbench.stage && typeof workbench.stage === 'object' ? workbench.stage : {};
      workbench.next = workbench.next && typeof workbench.next === 'object' ? workbench.next : {};
      workbench.scratch = workbench.scratch && typeof workbench.scratch === 'object' ? workbench.scratch : {};
      workbench.milestones = workbench.milestones && typeof workbench.milestones === 'object' ? workbench.milestones : {};
      workbench.progress = workbench.progress && typeof workbench.progress === 'object' ? workbench.progress : {};
      workbench.resurfaceIndex = Number.isFinite(Number(workbench.resurfaceIndex)) ? Number(workbench.resurfaceIndex) : 0;
      Object.keys(workbench.stage).forEach(id => { workbench.stage[id] = normalizeStage(workbench.stage[id]); });
      saveJson(WORKBENCH_KEY, workbench);

      let currentView = safeGet(VIEW_KEY) || 'cockpit';
      if (!['cockpit','board','library'].includes(currentView)) currentView = 'cockpit';
      let openIdeaId = null;
      let draggingId = null;
      let parkedVisible = false;
      let suppressOpenUntil = 0;
      let lastPeekTrigger = null;

      const publicById = new Map(seedIdeas.map(item => [item.id, item]));
      const findPrivate = id => privateIdeas.find(item => item.id === id);
      const savePrivate = () => saveJson(INBOX_KEY, privateIdeas);
      const saveWorkbench = () => saveJson(WORKBENCH_KEY, workbench);
      const getStage = item => normalizeStage(item.source === 'private' ? item.stage : (workbench.stage[item.id] || item.stage));
      const getNext = item => item.source === 'private' ? (item.nextAction || '') : (workbench.next[item.id] ?? item.nextAction ?? '');
      const getTitle = item => item.source === 'private' ? item.title : t(item.title, item.titleZh);
      const getSummary = item => item.source === 'private' ? (item.note || t('Private capture', '私人记录')) : t(item.summary, item.summaryZh);
      const getAreaLabel = area => t(normalizeArea(area), areaZh[normalizeArea(area)] || normalizeArea(area));
      const getStageLabel = stage => t(stageEn[normalizeStage(stage)] || stage, stageZh[normalizeStage(stage)] || stage);
      const publicItems = () => seedIdeas.map(item => ({ ...item, source:'public' }));
      const privateItems = () => privateIdeas.map(item => ({ ...item, source:'private', summary:item.note || '', summaryZh:item.note || '', updatedDate:item.updatedAt, createdDate:item.createdAt, milestones:[], tags:[] }));
      const allItems = () => [...publicItems(), ...privateItems()];
      const byId = id => {
        const local = findPrivate(id);
        if (local) return { ...local, source:'private', summary:local.note || '', summaryZh:local.note || '', updatedDate:local.updatedAt, createdDate:local.createdAt, milestones:[], tags:[] };
        const pub = publicById.get(id);
        return pub ? { ...pub, source:'public' } : null;
      };
      const milestoneState = item => {
        if (item.source === 'private') return [];
        const overrides = workbench.milestones[item.id] || {};
        return (item.milestones || []).map((milestone, index) => ({ ...milestone, done:Object.prototype.hasOwnProperty.call(overrides,index) ? Boolean(overrides[index]) : milestone.done, index }));
      };
      const progressPct = item => {
        const milestones = milestoneState(item);
        if (!milestones.length) return null;
        const done = milestones.filter(m => m.done).length;
        return { done, total:milestones.length, pct:Math.round(done / milestones.length * 100) };
      };

      const progressOrbit = progress => progress ? `
        <span class="idea-progress-orbit" title="${progress.done}/${progress.total}">
          <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="orbit-track" cx="18" cy="18" r="15.5"></circle><circle class="orbit-value" cx="18" cy="18" r="15.5" pathLength="100" stroke-dasharray="${progress.pct} 100"></circle></svg>
          <small>${progress.done}/${progress.total}</small>
        </span>` : '';

      const updateStatusLine = () => {
        const items = allItems();
        const active = items.filter(item => getStage(item) === 'Active').length;
        const inbox = privateIdeas.filter(item => getStage(item) === 'Spark').length;
        const node = $('#idea-view-status');
        if (node) node.textContent = t(`${active} in motion · ${inbox} private inbox`, `${active} 个推进中 · ${inbox} 个私人收件箱`);
      };

      const renderFlow = () => {
        const container = $('#idea-flow-visual');
        if (!container) return;
        const items = allItems();
        container.innerHTML = `<div class="idea-flow-track">${stageOrder.map((stage, index) => {
          const count = items.filter(item => getStage(item) === stage).length;
          const dots = Array.from({ length:Math.min(count, 7) }, (_, dot) => `<i style="--dot:${dot}" aria-hidden="true"></i>`).join('');
          const overflow = count > 7 ? `<em>+${count - 7}</em>` : '';
          return `<button class="idea-flow-stage${stage === 'Active' ? ' is-focus' : ''}" type="button" data-flow-stage="${stage}" aria-label="${escapeText(t(flowLabelEn[stage], flowLabelZh[stage]))}: ${count}">
            <span class="idea-flow-node"><b></b></span>
            <span class="idea-flow-index">0${index + 1}</span>
            <strong>${escapeText(t(flowLabelEn[stage], flowLabelZh[stage]))}</strong>
            <span class="idea-flow-count">${count}</span>
            <span class="idea-flow-dots">${dots}${overflow}</span>
          </button>`;
        }).join('')}</div>`;
      };

      const motionRow = (item, index) => {
        const next = getNext(item);
        const progress = progressPct(item);
        const updated = item.source === 'private' ? item.updatedAt : item.updatedDate;
        return `<button class="motion-row${index === 0 ? ' is-leading' : ''}" type="button" data-open-idea="${escapeText(item.id)}">
          <span class="motion-index">${String(index + 1).padStart(2,'0')}</span>
          <span class="motion-main"><span class="motion-meta">${escapeText(getAreaLabel(item.area))} · ${escapeText(item.source === 'private' ? t('Private', '私密') : t('Public', '公开'))}</span><strong>${escapeText(getTitle(item))}</strong><span class="motion-summary">${escapeText(getSummary(item))}</span></span>
          <span class="motion-next"><small>${escapeText(t('Next', '下一步'))}</small><span>${escapeText(next || t('Define the next concrete move.', '先定义一个具体的下一步。'))}</span></span>
          <span class="motion-progress">${progress ? progressOrbit(progress) : `<span class="motion-date">${escapeText(formatDate(updated))}</span>`}</span>
        </button>`;
      };

      const renderCockpit = () => {
        const active = allItems().filter(item => getStage(item) === 'Active').sort((a,b) => Date.parse(b.updatedDate || b.updatedAt || b.createdDate) - Date.parse(a.updatedDate || a.updatedAt || a.createdDate));
        const motion = $('#idea-motion-list');
        if (motion) motion.innerHTML = active.length ? active.slice(0,4).map(motionRow).join('') : `<div class="studio-empty-state"><strong>${escapeText(t('Nothing is in motion.', '现在没有正在推进的想法。'))}</strong><p>${escapeText(t('Move one idea into “In motion” when you know its next action.', '当你知道一个想法的下一步时，再把它移到“推进中”。'))}</p><button type="button" data-switch-view="board">${escapeText(t('Open Board →', '打开推进板 →'))}</button></div>`;

        const localInbox = privateIdeas.filter(item => getStage(item) === 'Spark').sort((a,b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
        const inbox = $('#idea-inbox-list');
        const emptyCapture = $('#idea-empty-capture');
        if (inbox) inbox.innerHTML = localInbox.slice(0,7).map(item => `<button class="inbox-slip" type="button" data-open-idea="${escapeText(item.id)}"><span class="inbox-slip-dot"></span><span><strong>${escapeText(item.title)}</strong><small>${escapeText(getAreaLabel(item.area))} · ${escapeText(formatDate(item.createdAt))}</small></span><span class="inbox-slip-arrow">↗</span></button>`).join('');
        if (emptyCapture) emptyCapture.hidden = localInbox.length > 0;
        renderResurface();
      };

      const resurfaceCandidates = () => allItems().filter(item => {
        const stage = getStage(item);
        return stage === 'Exploring' || (stage === 'Spark' && item.source === 'public');
      });
      const renderResurface = () => {
        const container = $('#idea-resurface-content');
        if (!container) return;
        const candidates = resurfaceCandidates();
        if (!candidates.length) { container.innerHTML = `<p class="resurface-empty">${escapeText(t('Nothing waiting to resurface right now.', '现在没有需要重新浮现的想法。'))}</p>`; return; }
        const index = Math.abs(Number(workbench.resurfaceIndex || 0)) % candidates.length;
        const item = candidates[index];
        const stage = getStage(item);
        const targetStage = stage === 'Spark' ? 'Exploring' : 'Active';
        const primaryLabel = stage === 'Spark' ? t('Develop', '继续发展') : t('Move to In motion', '开始推进');
        container.innerHTML = `<button class="resurface-idea" type="button" data-open-idea="${escapeText(item.id)}"><span class="resurface-quote">“</span><span><strong>${escapeText(getTitle(item))}</strong><small>${escapeText(getSummary(item))}</small></span></button><div class="resurface-actions"><button type="button" data-resurface-move="${targetStage}" data-resurface-id="${escapeText(item.id)}">${escapeText(primaryLabel)}</button><button type="button" data-resurface-park="${escapeText(item.id)}">${escapeText(t('Park','搁置'))}</button><button type="button" data-resurface-another>${escapeText(t('Another ↻','换一个 ↻'))}</button></div>`;
      };

      const boardCard = item => {
        const next = getNext(item);
        const progress = progressPct(item);
        const stage = getStage(item);
        return `<article class="board-card${item.source === 'private' ? ' is-private' : ''}" draggable="true" data-stage="${stage}" data-drag-idea="${escapeText(item.id)}" data-open-idea="${escapeText(item.id)}" tabindex="0" role="button"><div class="board-card-top"><span>${escapeText(getAreaLabel(item.area))}</span><span class="board-grip" aria-hidden="true">⠿</span></div><h4>${escapeText(getTitle(item))}</h4>${next ? `<p><span>${escapeText(t('Next','下一步'))}</span>${escapeText(next)}</p>` : `<p class="board-card-summary">${escapeText(getSummary(item))}</p>`}<div class="board-card-foot"><span>${item.source === 'private' ? escapeText(t('Private','私密')) : escapeText(t('Public','公开'))}</span>${progress ? `<span class="board-mini-progress"><span><i style="width:${progress.pct}%"></i></span><b>${progress.done}/${progress.total}</b></span>` : ''}</div></article>`;
      };

      const syncParkedButton = () => {
        const button = $('#show-parked');
        if (!button) return;
        button.textContent = parkedVisible ? t('Hide parked', '收起搁置项') : t('Show parked', '查看搁置项');
        button.setAttribute('aria-expanded', parkedVisible ? 'true' : 'false');
      };

      const renderBoard = () => {
        const items = allItems();
        stageOrder.forEach(stage => {
          const zone = document.querySelector(`[data-drop-stage="${stage}"]`);
          const matches = items.filter(item => getStage(item) === stage);
          const count = document.querySelector(`[data-lane-count="${stage}"]`);
          if (count) count.textContent = String(matches.length);
          if (zone) zone.innerHTML = matches.map(boardCard).join('') || `<div class="board-lane-empty">${escapeText(t('No ideas here yet', '这里还没有想法'))}</div>`;
        });
        const parked = items.filter(item => getStage(item) === 'Parked');
        const shelf = $('#parked-shelf');
        if (shelf) {
          shelf.hidden = !parkedVisible;
          shelf.innerHTML = parkedVisible ? `<div class="parked-head"><span>${escapeText(t('Parked ideas','已搁置想法'))}</span><strong>${parked.length}</strong></div><div class="parked-list">${parked.map(item => `<button type="button" data-open-idea="${escapeText(item.id)}"><span>${escapeText(getTitle(item))}</span><small>${escapeText(getAreaLabel(item.area))}</small></button>`).join('') || `<p>${escapeText(t('No parked ideas.','没有已搁置想法。'))}</p>`}</div>` : '';
        }
        syncParkedButton();
      };

      const renderLibraryControls = () => {
        const stageSelect = $('#idea-library-stage');
        const areaSelect = $('#idea-library-area');
        const captureArea = $('#idea-capture-area');
        if (stageSelect) {
          const current = stageSelect.value || 'all';
          stageSelect.innerHTML = `<option value="all">${escapeText(t('All stages','全部状态'))}</option>${validStages.map(stage => `<option value="${stage}">${escapeText(getStageLabel(stage))}</option>`).join('')}`;
          stageSelect.value = [...stageSelect.options].some(option => option.value === current) ? current : 'all';
        }
        if (areaSelect) {
          const current = areaSelect.value || 'all';
          areaSelect.innerHTML = `<option value="all">${escapeText(t('All areas','全部领域'))}</option>${areas.map(area => `<option value="${area}">${escapeText(getAreaLabel(area))}</option>`).join('')}`;
          areaSelect.value = [...areaSelect.options].some(option => option.value === current) ? current : 'all';
        }
        if (captureArea) {
          const current = captureArea.value || 'Unsorted';
          captureArea.innerHTML = areas.map(area => `<option value="${area}">${escapeText(getAreaLabel(area))}</option>`).join('');
          captureArea.value = [...captureArea.options].some(option => option.value === current) ? current : 'Unsorted';
        }
        const search = $('#idea-library-search');
        if (search) search.placeholder = t('Search ideas…','搜索想法…');
        const captureTitle = $('#idea-capture-title');
        if (captureTitle) captureTitle.placeholder = t('One sentence is enough…','一句话就够了……');
        const captureNote = $('#idea-capture-note');
        if (captureNote) captureNote.placeholder = t('Why did this feel worth keeping?','为什么这个念头值得留下？');
      };

      const renderLibrary = () => {
        renderLibraryControls();
        const query = String($('#idea-library-search')?.value || '').trim().toLowerCase();
        const stageFilter = $('#idea-library-stage')?.value || 'all';
        const areaFilter = $('#idea-library-area')?.value || 'all';
        const items = allItems().filter(item => {
          const haystack = [item.title,item.titleZh,item.summary,item.summaryZh,item.note,item.area,...(item.tags || [])].filter(Boolean).join(' ').toLowerCase();
          return (!query || haystack.includes(query)) && (stageFilter === 'all' || getStage(item) === stageFilter) && (areaFilter === 'all' || normalizeArea(item.area) === areaFilter);
        }).sort((a,b) => Date.parse(b.updatedDate || b.updatedAt || b.createdDate) - Date.parse(a.updatedDate || a.updatedAt || a.createdDate));
        const list = $('#idea-library-list');
        const empty = $('#idea-library-empty');
        if (list) list.innerHTML = items.map(item => `<button class="library-row" type="button" data-open-idea="${escapeText(item.id)}"><time>${escapeText(formatDate(item.updatedDate || item.updatedAt || item.createdDate))}</time><span class="library-row-copy"><strong>${escapeText(getTitle(item))}</strong><small>${escapeText(getSummary(item))}</small></span><span class="library-row-area">${escapeText(getAreaLabel(item.area))}</span><span class="library-row-stage">${escapeText(getStageLabel(getStage(item)))}</span><span class="library-row-source">${escapeText(item.source === 'private' ? t('private','私密') : t('public','公开'))}</span><span class="library-row-arrow">→</span></button>`).join('');
        if (empty) { empty.hidden = items.length > 0; empty.textContent = t('No ideas match this view.','没有符合当前条件的想法。'); }
      };

      const stageSelectMarkup = currentStage => `<label class="peek-field"><span>${escapeText(t('Stage','状态'))}</span><select id="peek-stage-select">${validStages.map(stage => `<option value="${stage}"${stage === currentStage ? ' selected' : ''}>${escapeText(getStageLabel(stage))}</option>`).join('')}</select></label>`;
      const areaSelectMarkup = item => `<label class="peek-field"><span>${escapeText(t('Area','领域'))}</span><select id="peek-area-select">${areas.map(area => `<option value="${area}"${area === normalizeArea(item.area) ? ' selected' : ''}>${escapeText(getAreaLabel(area))}</option>`).join('')}</select></label>`;

      const renderPeek = id => {
        const item = byId(id);
        const inner = $('#idea-peek-inner');
        if (!item || !inner) return closePeek();
        openIdeaId = id;
        const currentStage = getStage(item);
        const next = getNext(item);
        const publicMilestones = milestoneState(item);
        const staticProgress = item.progress || [];
        const localProgress = item.source === 'public' ? (workbench.progress[item.id] || []) : [];
        const combinedProgress = item.source === 'public' ? [...localProgress.map(entry => ({ ...entry, local:true })), ...staticProgress] : staticProgress;
        const scratch = item.source === 'public' ? (workbench.scratch[item.id] || '') : (item.note || '');
        const progress = progressPct(item);
        inner.innerHTML = `<div class="peek-topbar"><span class="peek-source">${escapeText(item.source === 'private' ? t('PRIVATE CAPTURE','私人记录') : t('PUBLIC IDEA · LOCAL WORKBENCH','公开想法 · 本地工作台'))}</span><button class="peek-close" id="peek-close" type="button" aria-label="Close">×</button></div>
          <header class="peek-header"><div class="peek-header-visual"><span class="peek-stage-orb" data-stage="${currentStage}"></span>${progress ? progressOrbit(progress) : ''}</div><div class="peek-meta">${escapeText(getAreaLabel(item.area))} · ${escapeText(getStageLabel(currentStage))}</div>${item.source === 'private' ? `<input class="peek-title-input" id="peek-private-title" value="${escapeText(item.title)}" maxlength="160" aria-label="Idea title" />` : `<h2>${escapeText(getTitle(item))}</h2>`}<p>${escapeText(getSummary(item))}</p></header>
          <div class="peek-fields-row">${stageSelectMarkup(currentStage)}${item.source === 'private' ? areaSelectMarkup(item) : `<div class="peek-field is-static"><span>${escapeText(t('Area','领域'))}</span><strong>${escapeText(getAreaLabel(item.area))}</strong></div>`}</div>
          <section class="peek-section peek-next-section"><div class="peek-section-head"><span>${escapeText(t('Next action','下一步'))}</span><small>${escapeText(t('local','本地'))}</small></div><textarea class="peek-next-input" id="peek-next-input" rows="2" placeholder="${escapeText(t('What is the next concrete move?','下一步最具体的动作是什么？'))}">${escapeText(next)}</textarea></section>
          <section class="peek-section"><div class="peek-section-head"><span>${escapeText(item.source === 'private' ? t('Quick note','随手记') : t('Local scratchpad','本地草稿'))}</span><small>${escapeText(t('browser only','仅本机'))}</small></div><textarea class="peek-scratch-input" id="peek-scratch-input" rows="5" placeholder="${escapeText(t('Think here without publishing anything…','可以在这里继续想，不会公开……'))}">${escapeText(scratch)}</textarea></section>
          ${publicMilestones.length ? `<section class="peek-section"><div class="peek-section-head"><span>${escapeText(t('Milestones','里程碑'))}</span><small>${publicMilestones.filter(m => m.done).length}/${publicMilestones.length}</small></div><div class="peek-milestones">${publicMilestones.map(m => `<label><input type="checkbox" data-peek-milestone="${m.index}"${m.done ? ' checked' : ''} /><span>${escapeText(t(m.text,m.textZh))}</span></label>`).join('')}</div></section>` : ''}
          <section class="peek-section"><div class="peek-section-head"><span>${escapeText(t('Progress log','推进记录'))}</span><small>${combinedProgress.length}</small></div><div class="peek-progress-list">${combinedProgress.slice().sort((a,b) => Date.parse(b.date || b.createdAt) - Date.parse(a.date || a.createdAt)).map(entry => `<div><time>${escapeText(formatDate(entry.date || entry.createdAt))}</time><p>${escapeText(entry.local || item.source === 'private' ? entry.note : t(entry.note,entry.noteZh))}</p></div>`).join('') || `<p class="peek-empty-copy">${escapeText(t('No updates yet.','还没有推进记录。'))}</p>`}</div><form class="peek-add-progress" id="peek-progress-form"><input id="peek-progress-input" maxlength="300" placeholder="${escapeText(t('Add a short update…','补一条简短进展……'))}" /><button type="submit" aria-label="Add progress">+</button></form></section>
          <footer class="peek-footer">${item.source === 'public' ? `<a href="${escapeText(item.href)}">${escapeText(t('Open full page ↗','打开完整页面 ↗'))}</a>` : `<button class="peek-delete" id="peek-delete-private" type="button">${escapeText(t('Delete capture','删除记录'))}</button>`}<span>${escapeText(t('Local edits never change the public site.','本地修改不会自动改变公开网站。'))}</span></footer>`;
        $('#idea-peek')?.setAttribute('aria-hidden','false');
        $('#idea-peek')?.classList.add('open');
        const backdrop = $('#idea-peek-backdrop'); if (backdrop) backdrop.hidden = false;
        document.body.classList.add('idea-peek-open');
        bindPeek(item);
      };

      const bindPeek = item => {
        $('#peek-close')?.addEventListener('click', closePeek);
        $('#peek-stage-select')?.addEventListener('change', event => setStage(item.id, event.target.value, { reopen:true }));
        $('#peek-area-select')?.addEventListener('change', event => {
          if (item.source !== 'private') return;
          const local = findPrivate(item.id); if (!local) return;
          local.area = normalizeArea(event.target.value); local.updatedAt = nowIso(); savePrivate(); renderAll(); renderPeek(item.id);
        });
        $('#peek-private-title')?.addEventListener('input', event => { const local = findPrivate(item.id); if (!local) return; local.title = String(event.target.value || '').slice(0,160); local.updatedAt = nowIso(); savePrivate(); });
        $('#peek-private-title')?.addEventListener('change', renderAll);
        $('#peek-next-input')?.addEventListener('input', event => {
          if (item.source === 'private') { const local = findPrivate(item.id); if (!local) return; local.nextAction = event.target.value; local.updatedAt = nowIso(); savePrivate(); }
          else { workbench.next[item.id] = event.target.value; saveWorkbench(); }
        });
        $('#peek-next-input')?.addEventListener('change', renderAll);
        $('#peek-scratch-input')?.addEventListener('input', event => {
          if (item.source === 'private') { const local = findPrivate(item.id); if (!local) return; local.note = event.target.value; local.updatedAt = nowIso(); savePrivate(); }
          else { workbench.scratch[item.id] = event.target.value; saveWorkbench(); }
        });
        $$('[data-peek-milestone]').forEach(checkbox => checkbox.addEventListener('change', event => { workbench.milestones[item.id] ||= {}; workbench.milestones[item.id][event.target.dataset.peekMilestone] = event.target.checked; saveWorkbench(); renderAll(); renderPeek(item.id); }));
        $('#peek-progress-form')?.addEventListener('submit', event => {
          event.preventDefault();
          const input = $('#peek-progress-input'); const note = String(input?.value || '').trim(); if (!note) return;
          const entry = { date:nowIso(), note };
          if (item.source === 'private') { const local = findPrivate(item.id); if (!local) return; local.progress ||= []; local.progress.unshift(entry); local.updatedAt = entry.date; savePrivate(); }
          else { workbench.progress[item.id] ||= []; workbench.progress[item.id].unshift(entry); saveWorkbench(); }
          renderAll(); renderPeek(item.id); toast(t('Progress saved locally.','推进记录已保存在本机。'));
        });
        $('#peek-delete-private')?.addEventListener('click', () => { privateIdeas = privateIdeas.filter(local => local.id !== item.id); savePrivate(); closePeek(); renderAll(); toast(t('Capture deleted.','记录已删除。')); });
      };

      const openPeek = (id, trigger = null) => {
        if (!byId(id)) return;
        if (trigger) lastPeekTrigger = trigger;
        renderPeek(id);
        requestAnimationFrame(() => $('#peek-close')?.focus({ preventScroll:true }));
      };
      const closePeek = () => {
        openIdeaId = null;
        $('#idea-peek')?.classList.remove('open');
        $('#idea-peek')?.setAttribute('aria-hidden','true');
        const backdrop = $('#idea-peek-backdrop'); if (backdrop) backdrop.hidden = true;
        document.body.classList.remove('idea-peek-open');
        const target = lastPeekTrigger; lastPeekTrigger = null;
        if (target?.isConnected) requestAnimationFrame(() => target.focus({ preventScroll:true }));
      };

      const setStage = (id, stage, options = {}) => {
        const normalized = normalizeStage(stage);
        const local = findPrivate(id);
        if (local) { local.stage = normalized; local.updatedAt = nowIso(); savePrivate(); }
        else if (publicById.has(id)) { workbench.stage[id] = normalized; saveWorkbench(); }
        else return;
        renderAll();
        if (options.reopen && openIdeaId === id) renderPeek(id);
        toast(t(`Moved to ${stageEn[normalized]}.`, `已移动到${stageZh[normalized]}。`));
      };

      const focusBoardLane = stage => {
        setView('board');
        requestAnimationFrame(() => document.querySelector(`[data-board-lane="${normalizeStage(stage)}"]`)?.scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' }));
      };
      const setView = view => {
        if (!['cockpit','board','library'].includes(view)) return;
        currentView = view; try { localStorage.setItem(VIEW_KEY,view); } catch {}
        $$('[data-idea-view]').forEach(button => { const active = button.dataset.ideaView === view; button.classList.toggle('active',active); button.setAttribute('aria-pressed',active ? 'true' : 'false'); });
        $$('[data-idea-view-panel]').forEach(panel => { const active = panel.dataset.ideaViewPanel === view; panel.hidden = !active; panel.classList.toggle('active',active); });
        if (view === 'board') renderBoard();
        if (view === 'library') renderLibrary();
      };

      const captureDialog = $('#idea-capture-dialog');
      const captureForm = $('#idea-capture-form');
      const captureTitle = $('#idea-capture-title');
      const openCapture = () => {
        renderLibraryControls();
        if (!captureDialog || captureDialog.open) return;
        if (openIdeaId) closePeek();
        try { captureDialog.showModal(); } catch { captureDialog.setAttribute('open',''); }
        requestAnimationFrame(() => captureTitle?.focus());
      };
      const closeCapture = () => { if (!captureDialog?.open) return; try { captureDialog.close(); } catch { captureDialog.removeAttribute('open'); } };
      const toast = message => { const node = $('#idea-toast'); if (!node) return; node.textContent = message; node.classList.add('visible'); clearTimeout(toast.timer); toast.timer = setTimeout(() => node.classList.remove('visible'),2100); };

      const bindDynamic = () => {
        $$('[data-open-idea]').forEach(element => {
          if (element.dataset.boundOpen) return; element.dataset.boundOpen = '1';
          element.addEventListener('click', event => { if (performance.now() < suppressOpenUntil) { event.preventDefault(); return; } event.preventDefault(); openPeek(element.dataset.openIdea, element); });
          element.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openPeek(element.dataset.openIdea, element); } });
        });
        $$('[data-flow-stage]').forEach(button => { if (button.dataset.boundFlow) return; button.dataset.boundFlow='1'; button.addEventListener('click', () => focusBoardLane(button.dataset.flowStage)); });
        $$('[data-switch-view]').forEach(button => { if (button.dataset.boundSwitch) return; button.dataset.boundSwitch='1'; button.addEventListener('click', () => setView(button.dataset.switchView)); });
        $$('[data-resurface-move]').forEach(button => { if (button.dataset.boundMove) return; button.dataset.boundMove='1'; button.addEventListener('click', () => setStage(button.dataset.resurfaceId, button.dataset.resurfaceMove)); });
        $$('[data-resurface-park]').forEach(button => { if (button.dataset.boundPark) return; button.dataset.boundPark='1'; button.addEventListener('click', () => setStage(button.dataset.resurfacePark,'Parked')); });
        $$('[data-resurface-another]').forEach(button => { if (button.dataset.boundAnother) return; button.dataset.boundAnother='1'; button.addEventListener('click', () => { const count = resurfaceCandidates().length || 1; workbench.resurfaceIndex = (workbench.resurfaceIndex + 1) % count; saveWorkbench(); renderResurface(); bindDynamic(); }); });
        $$('[data-drag-idea]').forEach(card => {
          if (card.dataset.boundDrag) return; card.dataset.boundDrag='1';
          card.addEventListener('dragstart', event => { draggingId = card.dataset.dragIdea; suppressOpenUntil = performance.now() + 900; card.classList.add('dragging'); if (event.dataTransfer) { event.dataTransfer.effectAllowed='move'; event.dataTransfer.setData('text/plain',draggingId || ''); } });
          card.addEventListener('dragend', () => { card.classList.remove('dragging'); draggingId = null; $$('.board-dropzone').forEach(zone => zone.classList.remove('drag-over')); suppressOpenUntil = Math.max(suppressOpenUntil, performance.now() + 180); });
        });
      };

      const renderAll = () => { updateStatusLine(); renderFlow(); renderCockpit(); renderBoard(); renderLibrary(); bindDynamic(); };

      $$('.board-dropzone').forEach(zone => {
        zone.addEventListener('dragover', event => { event.preventDefault(); zone.classList.add('drag-over'); if (event.dataTransfer) event.dataTransfer.dropEffect='move'; });
        zone.addEventListener('dragleave', event => { if (!zone.contains(event.relatedTarget)) zone.classList.remove('drag-over'); });
        zone.addEventListener('drop', event => { event.preventDefault(); zone.classList.remove('drag-over'); const id = draggingId || event.dataTransfer?.getData('text/plain'); draggingId = null; suppressOpenUntil = performance.now() + 350; if (id) setStage(id, zone.dataset.dropStage); });
      });

      $$('[data-idea-view]').forEach(button => button.addEventListener('click', () => setView(button.dataset.ideaView)));
      $('#idea-capture-trigger')?.addEventListener('click', openCapture);
      $('#idea-inbox-capture')?.addEventListener('click', openCapture);
      $('#idea-empty-capture')?.addEventListener('click', openCapture);
      $('#idea-capture-close')?.addEventListener('click', closeCapture);
      $('#idea-peek-backdrop')?.addEventListener('click', closePeek);
      $('#show-parked')?.addEventListener('click', () => { parkedVisible = !parkedVisible; renderBoard(); bindDynamic(); });
      $('#idea-library-search')?.addEventListener('input', renderLibrary);
      $('#idea-library-stage')?.addEventListener('change', renderLibrary);
      $('#idea-library-area')?.addEventListener('change', renderLibrary);

      captureDialog?.addEventListener('click', event => { const rect = captureDialog.getBoundingClientRect(); const inside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom; if (!inside) closeCapture(); });
      captureForm?.addEventListener('submit', event => {
        event.preventDefault();
        const data = new FormData(captureForm); const title = String(data.get('title') || '').trim(); if (!title) return;
        const now = nowIso(); const id = `local-${Date.now()}-${Math.random().toString(36).slice(2,7)}`;
        privateIdeas.unshift({ id, title:title.slice(0,160), note:String(data.get('note') || '').trim(), area:normalizeArea(String(data.get('area') || 'Unsorted')), stage:'Spark', nextAction:'', createdAt:now, updatedAt:now, progress:[] });
        savePrivate(); captureForm.reset(); closeCapture(); setView('cockpit'); renderAll(); toast(t('Saved to your private Inbox.','已存入你的私人收件箱。'));
      });

      document.addEventListener('keydown', event => {
        const tag = document.activeElement?.tagName?.toLowerCase();
        const editing = ['input','textarea','select'].includes(tag) || document.activeElement?.isContentEditable;
        if (event.key === 'Escape') { if (captureDialog?.open) { event.preventDefault(); closeCapture(); return; } if (openIdeaId) { event.preventDefault(); closePeek(); return; } }
        if (!editing && !openIdeaId && !captureDialog?.open && !event.metaKey && !event.ctrlKey && !event.altKey && event.key.toLowerCase() === 'c') { event.preventDefault(); openCapture(); }
      });
      document.addEventListener('kaize:ui-language', () => { renderAll(); renderLibraryControls(); if (openIdeaId) renderPeek(openIdeaId); });

      const params = new URLSearchParams(location.search);
      const requestedView = params.get('view');
      if (['cockpit','board','library'].includes(requestedView)) currentView = requestedView;
      renderLibraryControls(); setView(currentView); renderAll();
      const requestedOpen = params.get('open');
      if (params.get('capture') === '1') setTimeout(openCapture,80);
      else if (requestedOpen && byId(requestedOpen)) setTimeout(() => openPeek(requestedOpen),80);
    })();
  </script>
</BaseLayout>
