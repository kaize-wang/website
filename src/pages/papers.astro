---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { getPublishedNotes, noteSlug } from '@/utils/notes';
import { withBase } from '@/utils/url';

const notes = await getPublishedNotes();
const paperNotes = notes.filter(note => note.data.paper);
---
<BaseLayout title="Paper Reading" active="Notes">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Notes · Literature</div>
      <h1>Paper Reading</h1>
      <p>Reading notes kept beside the papers that matter. Open a note for the full reading record and, where available, the source-and-notes Reader workspace.</p>
    </header>

    <section class="section" aria-labelledby="paper-reading-list-title">
      <div class="section-head"><h2 id="paper-reading-list-title">Reading notes</h2><span class="section-kicker">{paperNotes.length} papers</span></div>

      <div class="paper-reading-list">
        {paperNotes.map(note => {
          const paper = note.data.paper!;
          return (
            <article class="paper-reading-row">
              <div class="paper-reading-year">{paper.year}</div>
              <div class="paper-reading-main">
                <h2><a href={withBase(`/notes/${noteSlug(note.id)}/`)}>{paper.title}</a></h2>
                <p class="paper-reading-authors">{paper.authors.join(' · ')}</p>
                {paper.venue && <p class="paper-reading-venue">{paper.venue}</p>}
                <p class="paper-reading-desc">{note.data.description}</p>
              </div>
              <a class="paper-reading-open" href={withBase(`/notes/${noteSlug(note.id)}/`)}>Open note →</a>
            </article>
          );
        })}
      </div>

      {paperNotes.length === 0 && <p class="muted">No Paper Reading notes yet.</p>}
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
