---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoidsPlayground from '@/components/BoidsPlayground.astro';
import VisitorAnalytics from '@/components/VisitorAnalytics.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { site } from '@/site.config';
---
<BaseLayout title="About" active="About">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">About</div>
      <h1>{site.fullName}</h1>
      <p>{site.shortBio}</p>
    </header>

    <section class="section">
      <div class="about-copy">
        {site.about.map(p => <p>{p}</p>)}
        <p>For academic correspondence, you can reach me at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Playground</h2><span class="section-kicker">Small things that make the site feel alive</span></div>
      <BoidsPlayground />
    </section>

    <section class="section" aria-labelledby="visitors-heading">
      <div class="section-head"><h2 id="visitors-heading">Visitors</h2><span class="section-kicker">A live, approximate footprint</span></div>
      <VisitorAnalytics />
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
