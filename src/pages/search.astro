---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { getPublishedNotes, formatDate, noteSlug } from '@/utils/notes';
import { withBase } from '@/utils/url';
const notes = await getPublishedNotes();
const index = notes.map(note => ({
  title: note.data.title,
  description: note.data.description,
  category: note.data.category,
  collection: note.data.collection || '',
  tags: note.data.tags,
  aliases: note.data.aliases || [],
  lang: note.data.lang,
  type: note.data.paper ? 'Paper reading' : note.data.category,
  date: formatDate(note.data.publishDate),
  href: withBase(`/notes/${noteSlug(note.id)}/`),
  body: note.body || '',
  extra: [
    note.data.englishSummary || '',
    note.data.paper?.title || '',
    ...(note.data.paper?.authors || []),
    ...note.data.references.flatMap(ref => [ref.title, ref.authors, ref.venue || '', ref.doi || ''])
  ].join(' ')
}));
---
<BaseLayout title="Search">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Notebook</div>
      <h1>Search</h1>
      <p>Search published notes by title, paper, author, keyword, or text from the note itself.</p>
    </header>
    <section class="section">
      <label for="q" class="muted" style="display:block;margin-bottom:8px;font-size:13px">Full-text search</label>
      <input id="q" type="search" placeholder="warranty age, base-stock, Huang…" class="smart-search-input" autofocus />
      <div class="search-summary" id="search-summary" aria-live="polite"></div>
      <div id="results" class="note-list smart-search-results"></div>
    </section>
  </main>
  <SiteExtras />
  <script is:inline define:vars={{ index }}>
    (() => {
      const input = document.querySelector('#q');
      const results = document.querySelector('#results');
      const summary = document.querySelector('#search-summary');
      const esc = s => String(s || '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const normalize = s => String(s || '').toLowerCase();
      const stripMarkdown = s => String(s || '')
        .replace(/```[\s\S]*?```/g, ' ')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/[#>*_~$\\{}\[\]]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      const termsFor = query => normalize(query).split(/\s+/).filter(Boolean);
      const makeSnippet = (note, terms) => {
        const text = stripMarkdown(`${note.description} ${note.body} ${note.extra}`);
        if (!terms.length) return note.description;
        const lower = normalize(text);
        const positions = terms.map(term => lower.indexOf(term)).filter(pos => pos >= 0);
        if (!positions.length) return note.description;
        const pos = Math.min(...positions);
        const start = Math.max(0, pos - 90);
        const end = Math.min(text.length, pos + 190);
        return `${start > 0 ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}`;
      };
      const scoreNote = (note, terms) => {
        const title = normalize(note.title);
        const meta = normalize([note.description,note.category,note.collection,...note.tags,...note.aliases,note.extra].join(' '));
        const body = normalize(note.body);
        return terms.reduce((score, term) => score + (title.includes(term) ? 8 : 0) + (meta.includes(term) ? 4 : 0) + (body.includes(term) ? 1 : 0), 0);
      };

      function render(query = '') {
        const terms = termsFor(query.trim());
        const rows = index
          .filter(note => {
            if (!terms.length) return true;
            const haystack = normalize([note.title,note.description,note.category,note.collection,...note.tags,...note.aliases,note.body,note.extra].join(' '));
            return terms.every(term => haystack.includes(term));
          })
          .map(note => ({ ...note, score: scoreNote(note, terms) }))
          .sort((a,b) => b.score - a.score || a.title.localeCompare(b.title));

        summary.textContent = `${rows.length} result${rows.length === 1 ? '' : 's'}${query.trim() ? ` for “${query.trim()}”` : ''}`;
        results.innerHTML = rows.length ? rows.map(note => `
          <article class="note-row smart-search-row">
            <div class="note-date">${esc(note.date)}</div>
            <div>
              <a href="${esc(note.href)}"><h3 class="note-title">${esc(note.title)}</h3></a>
              <p class="note-desc">${esc(makeSnippet(note, terms))}</p>
            </div>
            <div class="note-meta"><span>${esc(note.type)}</span><span>${esc(note.lang === 'zh' ? '中文' : 'EN')}</span></div>
          </article>`).join('') : '<p class="muted">No matching notes.</p>';
      }

      input?.addEventListener('input', event => render(event.target.value));
      render();
    })();
  </script>
</BaseLayout>
