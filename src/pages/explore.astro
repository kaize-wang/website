---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import '@/styles/knowledge.css';
import { getPublishedNotes } from '@/utils/notes';
import { withBase } from '@/utils/url';

const notes = await getPublishedNotes();
const collectionMap = new Map<string, number>();
const tagMap = new Map<string, number>();
const categoryMap = new Map<string, number>();
for (const note of notes) {
  categoryMap.set(note.data.category, (categoryMap.get(note.data.category) ?? 0) + 1);
  if (note.data.collection) collectionMap.set(note.data.collection, (collectionMap.get(note.data.collection) ?? 0) + 1);
  for (const tag of note.data.tags) tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
}
const categories = [...categoryMap.entries()].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const collections = [...collectionMap.entries()].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const tags = [...tagMap.entries()].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0,18);
---
<BaseLayout title="Explore Notes" active="Notes">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Notes · Explore</div>
      <h1>Explore Notes</h1>
      <p>Use these views when you want structure rather than the chronological note list: relationships, literature, archives, categories, series, and tags.</p>
    </header>

    <section class="section" aria-labelledby="explore-structure-title">
      <div class="section-head"><h2 id="explore-structure-title">Structure</h2><span class="section-kicker">Occasional tools, not primary navigation</span></div>
      <div class="explore-grid">
        <a class="explore-card" href={withBase('/graph')}>
          <span>Relationships</span><strong>Knowledge Graph</strong><p>Wiki links, related notes, time, paths, and serendipity.</p>
        </a>
        <a class="explore-card" href={withBase('/literature')}>
          <span>Literature</span><strong>Literature Map</strong><p>Reading notes connected to papers and explicitly recorded references.</p>
        </a>
        <a class="explore-card" href={withBase('/archive')}>
          <span>Chronology</span><strong>Archive</strong><p>All published notes grouped by year.</p>
        </a>
      </div>
    </section>

    {(categories.length > 0 || collections.length > 0 || tags.length > 0) && (
      <section class="section" aria-labelledby="explore-browse-title">
        <div class="section-head"><h2 id="explore-browse-title">Browse</h2><span class="section-kicker">Metadata views</span></div>
        <div class="explore-browse">
          {categories.length > 0 && (
            <div><span>Categories</span>{categories.map(([name,count]) => <a href={withBase(`/categories/${encodeURIComponent(name.toLowerCase())}/`)}>{name}<small>{count}</small></a>)}</div>
          )}
          {collections.length > 0 && (
            <div><span>Series</span>{collections.map(([name,count]) => <a href={withBase(`/collections/${encodeURIComponent(name.toLowerCase())}/`)}>{name}<small>{count}</small></a>)}</div>
          )}
          {tags.length > 0 && (
            <div><span>Tags</span>{tags.map(([name,count]) => <a href={withBase(`/tags/${encodeURIComponent(name.toLowerCase())}/`)}>#{name}<small>{count}</small></a>)}</div>
          )}
        </div>
      </section>
    )}
  </main>
  <SiteExtras />
</BaseLayout>
