---
import { getPublishedNotes, formatDate, readingTime, noteSlug, backlinksFor, outgoingWikiNotes } from '@/utils/notes';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import ResearchArticleTools from '@/components/ResearchArticleTools.astro';
import ArticleEnhancements from '@/components/ArticleEnhancements.astro';
import '@/styles/experiments.css';
import '@/styles/scholarly.css';
import '@/styles/knowledge.css';
import '@/styles/research-tools.css';
import { site } from '@/site.config';
import { withBase } from '@/utils/url';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const allNotes = await getPublishedNotes();
const translation = note.data.translationOf
  ? allNotes.find(item => item.id === note.data.translationOf)
  : allNotes.find(item => item.data.translationOf === note.id);
const translationLabel = note.data.lang === 'zh' ? 'Read in English' : '阅读中文版';
const paperUrl = note.data.paper?.url ?? (note.data.paper?.doi ? `https://doi.org/${note.data.paper.doi}` : '');
const currentTags = new Set(note.data.tags.map(tag => tag.toLowerCase()));
const relatedNotes = allNotes
  .filter(item => item.id !== note.id && item.id !== translation?.id)
  .map(item => {
    const sharedTags = item.data.tags.filter(tag => currentTags.has(tag.toLowerCase())).length;
    const sameCollection = Boolean(note.data.collection && item.data.collection === note.data.collection);
    const sameCategory = item.data.category === note.data.category;
    return { item, score: sharedTags * 2 + (sameCollection ? 4 : 0) + (sameCategory ? 1 : 0) };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.item.data.publishDate.valueOf() - a.item.data.publishDate.valueOf())
  .slice(0, 3)
  .map(({ item }) => item);
const backlinks = backlinksFor(note, allNotes);
const outgoingWiki = outgoingWikiNotes(note, allNotes);
const wanderPool = [...outgoingWiki, ...backlinks, ...relatedNotes, ...allNotes.filter(item => item.id !== note.id)]
  .filter((item, index, list) => list.findIndex(candidate => candidate.id === item.id) === index)
  .slice(0, 10);
const wanderUrls = wanderPool.map(item => withBase(`/notes/${noteSlug(item.id)}/`));
const wikiNotes = allNotes.map(item => ({
  id: item.id,
  title: item.data.title,
  aliases: item.data.aliases || [],
  href: withBase(`/notes/${noteSlug(item.id)}/`)
}));
const hasNotation = /\[!notation(?:\s|\])/i.test(note.body || '');
const hasAssumptions = /\[!assumption(?:\s|\])/i.test(note.body || '');
const showArticleAside = toc.length >= 2 || hasNotation || hasAssumptions;
const canonicalUrl = new URL(withBase(`/notes/${noteSlug(note.id)}/`), Astro.site ?? Astro.url.origin).toString();
const citeYear = note.data.publishDate.getFullYear();
const citeKeyTail = note.id.replace(/[^a-z0-9]+/gi, '').slice(0, 20) || 'note';
const citation = {
  plain: `${site.fullName} (${citeYear}). ${note.data.title}. ${site.title}. ${canonicalUrl}`,
  markdown: `[${note.data.title}](${canonicalUrl}) — ${site.fullName}, ${citeYear}.`,
  bibtex: `@misc{wang${citeYear}${citeKeyTail},\n  author = {${site.fullName}},\n  title = {${note.data.title.replace(/[{}]/g, '')}},\n  year = {${citeYear}},\n  url = {${canonicalUrl}},\n  note = {${site.title}}\n}`
};
---
<BaseLayout title={note.data.title} description={note.data.description} active="Notes">
  <div class="article-page-layout">
    <article class="article-wrap" lang={note.data.lang === 'zh' ? 'zh-CN' : 'en'}>
      <header class="article-head">
        <div class="eyebrow">{note.data.category}{note.data.collection ? ` · ${note.data.collection}` : ''}</div>
        <h1>{note.data.title}</h1>
        <div class="article-meta">
          <span>{formatDate(note.data.publishDate)}</span>
          {note.data.updatedDate && <span>Updated {formatDate(note.data.updatedDate)}</span>}
          <span>{readingTime(note.body)} min read</span>
          <span class="lang-chip">{note.data.lang === 'zh' ? '中文' : 'EN'}</span>
          {translation && <a class="translation-link" href={withBase(`/notes/${noteSlug(translation.id)}/`)}>{translationLabel}</a>}
        </div>
        <p class="article-desc">{note.data.description}</p>
        <div class="tags">{note.data.tags.map(tag => <a class="tag tag-link" data-preview={`Browse notes tagged ${tag}`} href={withBase(`/tags/${encodeURIComponent(tag.toLowerCase())}/`)}>{tag}</a>)}</div>

        {note.data.paper && (
          <div class="paper-meta-card">
            <span class="paper-meta-label">Paper</span>
            <strong>{note.data.paper.title}</strong>
            <div class="paper-meta-authors">{note.data.paper.authors.join(' · ')}</div>
            <div class="paper-meta-venue">{[note.data.paper.venue, note.data.paper.year].filter(Boolean).join(' · ')}</div>
            {(paperUrl || note.data.paper.doi) && (
              <div class="paper-meta-links">
                {paperUrl && <a href={paperUrl}>Open paper ↗</a>}
                {note.data.paper.doi && <span>DOI {note.data.paper.doi}</span>}
              </div>
            )}
          </div>
        )}

        {note.data.englishSummary && (
          <details class="bilingual-summary">
            <summary>English summary</summary>
            <p lang="en">{note.data.englishSummary}</p>
          </details>
        )}

        <div class="article-toolbox">
          <button class="mini-action" id="copy-page-link" type="button">Copy link</button>
          <button class="mini-action" id="cite-note" type="button">Cite</button>
          <button class="mini-action" id="academic-view" type="button" aria-pressed="false">Academic</button>
          <button class="mini-action" id="print-note" type="button">Print</button>
          <button class="focus-reading-button" id="focus-reading" type="button" aria-pressed="false">Focus</button>
          {wanderUrls.length > 0 && <button class="mini-action" id="wander-note" type="button" title="Follow a nearby note in the knowledge graph">Wander →</button>}
          <span class="article-local-visits"><strong id="busuanzi_page_pv">—</strong> views</span>
        </div>
      </header>

      <div class="resume-reading" id="resume-reading" aria-live="polite">
        <span id="resume-copy">Resume where you left off?</span>
        <button class="mini-action" id="resume-button" type="button">Resume reading →</button>
      </div>

      {toc.length >= 2 && (
        <details class="article-contents">
          <summary>Contents</summary>
          <nav>
            {toc.map(heading => <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>)}
          </nav>
        </details>
      )}
      <div class="prose"><Content /></div>

      {note.data.references.length > 0 && (
        <section class="reference-section" aria-labelledby="references-title">
          <h2 id="references-title">References</h2>
          <ol class="reference-list">
            {note.data.references.map(reference => (
              <li
                id={`ref-${reference.id}`}
                data-reference-id={reference.id}
                data-reference-title={reference.title}
                data-reference-authors={reference.authors}
                data-reference-year={String(reference.year)}
                data-reference-venue={reference.venue || ''}
                data-reference-doi={reference.doi || ''}
              >
                {reference.authors} ({reference.year}). <strong>{reference.title}</strong>{reference.venue ? `. ${reference.venue}.` : '.'}
                {' '}
                {reference.url
                  ? <a href={reference.url}>Source ↗</a>
                  : reference.doi
                    ? <a href={`https://doi.org/${reference.doi}`}>DOI ↗</a>
                    : null}
              </li>
            ))}
          </ol>
        </section>
      )}

      {backlinks.length > 0 && (
        <section class="backlinks-section" aria-labelledby="backlinks-title">
          <h2 id="backlinks-title">Referenced by</h2>
          <p class="backlinks-note">Notes that explicitly link here with <code>[[wiki links]]</code>.</p>
          <div class="backlinks-list">
            {backlinks.map(item => (
              <a class="backlink-item" href={withBase(`/notes/${noteSlug(item.id)}/`)}>
                <strong>{item.data.title}</strong>
                <span>{item.data.lang === 'zh' ? '中文' : 'EN'} · {item.data.collection || item.data.category}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedNotes.length > 0 && (
        <section class="related-notes-section" aria-labelledby="related-notes-title">
          <h2 id="related-notes-title">Related notes</h2>
          <div class="related-notes-list">
            {relatedNotes.map(item => (
              <a class="related-note" href={withBase(`/notes/${noteSlug(item.id)}/`)}>
                <strong>{item.data.title}</strong>
                <span>{item.data.lang === 'zh' ? '中文' : 'EN'} · {item.data.collection || item.data.category}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="article-reactions" aria-labelledby="reaction-title">
        <h2 id="reaction-title">Your reaction</h2>
        <p class="reaction-note">Stored only in this browser — no account and no global counter.</p>
        <div class="reaction-row">
          <button class="mini-action reaction-button" data-reaction="useful" type="button">Useful</button>
          <button class="mini-action reaction-button" data-reaction="interesting" type="button">Interesting</button>
          <button class="mini-action reaction-button" data-reaction="clear" type="button">Clear</button>
        </div>
      </section>

      <section class="comments-section" aria-labelledby="comments-title">
        <h2 id="comments-title">Comments</h2>
        <p class="comments-note">Powered by GitHub Issues through Utterances. GitHub sign-in is required to comment.</p>
        <div id="utterances-mount"></div>
        <p class="comments-fallback">If the widget says Utterances is not installed, authorize it for the <a href="https://github.com/apps/utterances">website repository</a> once. You can also use <a href="https://github.com/kaize-wang/website/issues">GitHub Issues</a> directly.</p>
      </section>

      <div class="backline"><a href={withBase('/notes')}>← Back to Notes</a><span>{headings.length ? `${headings.length} sections` : ''}</span></div>
    </article>

    {showArticleAside && (
      <aside class="floating-toc" data-floating-toc aria-label="Article tools">
        <div class="article-aside-tabs">
          {toc.length >= 2 && <button class="article-aside-tab active" type="button" data-aside-tab="outline">Outline</button>}
          {hasNotation && <button class={`article-aside-tab${toc.length < 2 ? ' active' : ''}`} type="button" data-aside-tab="notation">Notation</button>}
          {hasAssumptions && <button class={`article-aside-tab${toc.length < 2 && !hasNotation ? ' active' : ''}`} type="button" data-aside-tab="assumptions">Assumptions</button>}
        </div>
        {toc.length >= 2 && (
          <div class="article-aside-panel" data-aside-panel="outline">
            <div class="floating-toc-label">On this page</div>
            <nav>{toc.map(heading => <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
          </div>
        )}
        {hasNotation && (
          <div class="article-aside-panel" data-aside-panel="notation" hidden={toc.length >= 2}>
            <div class="floating-toc-label">Notation</div>
            <div class="article-aside-list"></div><p class="article-aside-empty">No notation blocks found.</p>
          </div>
        )}
        {hasAssumptions && (
          <div class="article-aside-panel" data-aside-panel="assumptions" hidden={toc.length >= 2 || hasNotation}>
            <div class="floating-toc-label">Assumptions</div>
            <div class="article-aside-list"></div><p class="article-aside-empty">No assumption blocks found.</p>
          </div>
        )}
      </aside>
    )}
  </div>
  <SiteExtras />
  <ResearchArticleTools citation={citation} />
  <ArticleEnhancements wikiNotes={wikiNotes} wanderUrls={wanderUrls} />

  <script is:inline>
  (() => {
    const copyText = async (text) => {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        const area = document.createElement('textarea');
        area.value = text;
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        return ok;
      }
    };

    const copyLink = document.getElementById('copy-page-link');
    copyLink?.addEventListener('click', async () => {
      const ok = await copyText(window.location.href);
      copyLink.textContent = ok ? 'Copied' : 'Copy failed';
      window.setTimeout(() => copyLink.textContent = 'Copy link', 1500);
    });

    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.querySelector('.code-copy')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent || pre.textContent || '';
        const ok = await copyText(code);
        button.textContent = ok ? 'Copied' : 'Failed';
        window.setTimeout(() => button.textContent = 'Copy', 1300);
      });
      pre.appendChild(button);
    });

    const pathKey = window.location.pathname;
    const readKey = `kaize-reading:${pathKey}`;
    const resume = document.getElementById('resume-reading');
    const resumeButton = document.getElementById('resume-button');
    const resumeCopy = document.getElementById('resume-copy');
    let saved = 0;
    try { saved = Number(localStorage.getItem(readKey) || '0'); } catch {}
    if (saved > .08 && saved < .92 && resume && resumeCopy) {
      resume.classList.add('visible');
      resumeCopy.textContent = `You previously reached about ${Math.round(saved * 100)}% of this note.`;
    }
    resumeButton?.addEventListener('click', () => {
      const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      window.scrollTo({ top: max * saved, behavior: 'smooth' });
      resume?.classList.remove('visible');
    });
    let readTick = false;
    window.addEventListener('scroll', () => {
      if (readTick) return;
      readTick = true;
      requestAnimationFrame(() => {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, window.scrollY / max));
        try {
          if (ratio > .96) localStorage.removeItem(readKey);
          else if (ratio > .03) localStorage.setItem(readKey, String(ratio));
        } catch {}
        readTick = false;
      });
    }, { passive: true });

    const reactionKey = `kaize-reaction:${pathKey}`;
    const reactionButtons = [...document.querySelectorAll('.reaction-button')];
    let currentReaction = '';
    try { currentReaction = localStorage.getItem(reactionKey) || ''; } catch {}
    const syncReaction = () => reactionButtons.forEach(button => button.classList.toggle('selected', button.dataset.reaction === currentReaction));
    reactionButtons.forEach(button => button.addEventListener('click', () => {
      currentReaction = currentReaction === button.dataset.reaction ? '' : button.dataset.reaction;
      try {
        if (currentReaction) localStorage.setItem(reactionKey, currentReaction);
        else localStorage.removeItem(reactionKey);
      } catch {}
      syncReaction();
    }));
    syncReaction();

    const utterancesMount = document.getElementById('utterances-mount');
    if (utterancesMount) {
      const utterancesScript = document.createElement('script');
      utterancesScript.src = 'https://utteranc.es/client.js';
      utterancesScript.async = true;
      utterancesScript.crossOrigin = 'anonymous';
      utterancesScript.setAttribute('repo', 'kaize-wang/website');
      utterancesScript.setAttribute('issue-term', 'pathname');
      utterancesScript.setAttribute('theme', 'preferred-color-scheme');
      utterancesMount.appendChild(utterancesScript);
    }
  })();
  </script>
</BaseLayout>
