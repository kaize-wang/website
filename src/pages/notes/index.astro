---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteList from '@/components/NoteList.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import '@/styles/scholarly.css';
import '@/styles/knowledge.css';
import { getPublishedNotes } from '@/utils/notes';
import { withBase } from '@/utils/url';
const notes = await getPublishedNotes();
---
<BaseLayout title="Notes" active="Notes">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Research · Reading · Technical · Life</div>
      <h1>Notes</h1>
      <p>A public notebook for ideas worth keeping. Open a note to read; use Paper Reading for literature work and Explore when you want graphs, archives, categories, series, or tags.</p>
    </header>

    <section class="section" aria-labelledby="all-notes-title">
      <div class="section-head">
        <h2 id="all-notes-title">All Notes</h2>
        <a class="section-kicker" href={withBase('/explore')}>Explore notes →</a>
      </div>
      {notes.length ? <NoteList notes={notes} /> : <p class="muted">No notes yet.</p>}
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
