---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VisitorAnalytics from '@/components/VisitorAnalytics.astro';
import BoidsPlayground from '@/components/BoidsPlayground.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { site } from '@/site.config';
import { getPublishedNotes, noteSlug } from '@/utils/notes';
import { withBase } from '@/utils/url';

const notes = await getPublishedNotes();
const noteUrls = notes.map(note => withBase(`/notes/${noteSlug(note.id)}/`));
const githubUsername = site.github?.split('/').filter(Boolean).pop() || 'kaize-wang';
---
<BaseLayout title="Lab">
  <main class="site-shell lab-page">
    <header class="page-hero">
      <div class="eyebrow">Optional · experimental</div>
      <h1>Lab</h1>
      <p>A small attic for things that are interesting, beautiful, or occasionally useful, but not important enough to complicate the main navigation.</p>
    </header>

    <section class="section" aria-labelledby="lab-tools-title">
      <div class="section-head">
        <h2 id="lab-tools-title">Tools & curiosities</h2>
        <span class="section-kicker">Open only when you want them</span>
      </div>
      <div class="explore-grid lab-grid">
        <a class="explore-card" href={withBase('/graph')}>
          <span>Notes</span><strong>Knowledge Graph</strong><p>Relationships, wiki links, paths, and the constellation view.</p>
        </a>
        <a class="explore-card" href={withBase('/literature')}>
          <span>Papers</span><strong>Literature Map</strong><p>A visual map between paper-reading notes and recorded references.</p>
        </a>
        <a class="explore-card" href={withBase('/questions')}>
          <span>Research</span><strong>Questions Board</strong><p>An experimental place for questions worth carrying forward.</p>
        </a>
        <a class="explore-card" href={withBase('/sandbox')}>
          <span>Play</span><strong>Research Sandbox</strong><p>Interactive sketches for mechanism intuition, separate from formal evidence.</p>
        </a>
        <a class="explore-card" href={withBase('/archive')}>
          <span>History</span><strong>Archive</strong><p>A chronological view for when the notebook becomes larger.</p>
        </a>
      </div>
    </section>

    {noteUrls.length > 0 && (
      <section class="section lab-rediscover" aria-labelledby="rediscover-title">
        <div class="section-head">
          <h2 id="rediscover-title"><span class="ui-copy-en">Rediscover</span><span class="ui-copy-zh">重新发现</span></h2>
          <span class="section-kicker"><span class="ui-copy-en">A little serendipity</span><span class="ui-copy-zh">留一点偶然性</span></span>
        </div>
        <button class="lab-surprise-button" id="lab-random-note" type="button">
          <span class="ui-copy-en">Surprise me</span><span class="ui-copy-zh">随便看看</span><span aria-hidden="true"> ↗</span>
        </button>
      </section>
    )}

    {site.github && (
      <section class="section lab-github-activity" aria-labelledby="github-activity-title">
        <div class="section-head">
          <h2 id="github-activity-title"><span class="ui-copy-en">GitHub Activity</span><span class="ui-copy-zh">GitHub 更新热图</span></h2>
          <a class="section-kicker" href={site.github}><span class="ui-copy-en">View profile →</span><span class="ui-copy-zh">查看主页 →</span></a>
        </div>
        <a class="lab-github-card" href={site.github} aria-label={`View ${site.fullName}'s GitHub profile`}>
          <div class="lab-github-chart-scroll">
            <img class="lab-github-chart lab-github-chart-light" src={`https://ghchart.xqsit94.in/light:7d2f2f/${githubUsername}`} alt={`${site.fullName}'s GitHub contribution chart`} loading="lazy" />
            <img class="lab-github-chart lab-github-chart-dark" src={`https://ghchart.xqsit94.in/dark:d4938d/${githubUsername}`} alt={`${site.fullName}'s GitHub contribution chart in dark mode`} loading="lazy" />
          </div>
          <span class="lab-github-note"><span class="ui-copy-en">Public contribution activity over the past year.</span><span class="ui-copy-zh">过去一年的公开 GitHub 贡献活动。</span></span>
        </a>
      </section>
    )}

    <VisitorAnalytics detailed />

    <section class="section" aria-labelledby="flocking-title">
      <div class="section-head"><h2 id="flocking-title">A small visual toy</h2><span class="section-kicker">No research claim attached</span></div>
      <BoidsPlayground />
    </section>
  </main>
  <SiteExtras />
  <script is:inline define:vars={{ noteUrls }}>
    document.getElementById('lab-random-note')?.addEventListener('click', () => {
      if (!noteUrls.length) return;
      window.location.assign(noteUrls[Math.floor(Math.random() * noteUrls.length)]);
    });
  </script>
</BaseLayout>
