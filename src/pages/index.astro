---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteList from '@/components/NoteList.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import VisitorAnalytics from '@/components/VisitorAnalytics.astro';
import '@/styles/ideas.css';
import { site } from '@/site.config';
import { applyIdeaWorkbenchState } from '@/utils/idea-workbench-state';
import { getPublishedNotes } from '@/utils/notes';
import { withBase } from '@/utils/url';
const notes = await getPublishedNotes();
const recent = notes.slice(0,4);
const ideas = (await getCollection('ideas', ({ data }) => !data.draft))
  .map(applyIdeaWorkbenchState)
  .filter(idea => idea.data.stage === 'Active' || idea.data.featured)
  .sort((a,b) => {
    const stageA = a.data.stage === 'Active' ? 1 : 0;
    const stageB = b.data.stage === 'Active' ? 1 : 0;
    return stageB - stageA || (b.data.updatedDate ?? b.data.createdDate).valueOf() - (a.data.updatedDate ?? a.data.createdDate).valueOf();
  })
  .slice(0,2);
const areaZh: Record<string, string> = { Research:'研究', Build:'构建', Life:'生活', Writing:'写作', Learning:'学习' };
const stageZh: Record<string, string> = { Spark:'灵感', Exploring:'酝酿中', Active:'推进中', Realized:'已落地', Parked:'已搁置' };
const githubUsername = site.github?.split('/').filter(Boolean).pop() || 'kaize-wang';
---
<BaseLayout title={site.title} active="Home">
  <main class="site-shell home-page">
    <div class="hero-banner">
      <img src={withBase('/banner-placeholder.svg')} alt="Website banner" />
      <div class="banner-caption">{site.bannerCaption}</div>
    </div>

    <section class="profile-grid">
      <div><img class="avatar avatar-reactive" data-avatar-reactive src={site.avatar} alt={`${site.fullName} profile photo`} /></div>
      <div>
        <div class="eyebrow">Academic homepage · research notes</div>
        <h1>{site.fullName}</h1>
        <p class="role">{site.role}</p>
        <p class="affiliation">{site.affiliation} · {site.location}</p>
        <div class="profile-links">
          <a class="pill" href={`mailto:${site.email}`}>Email</a>
          {site.scholar && <a class="pill" href={site.scholar}>Google Scholar</a>}
          {site.github && <a class="pill" href={site.github}>GitHub</a>}
          {site.cv && <a class="pill" href={site.cv}>CV</a>}
        </div>
        <div class="about-copy">{site.about.map(p => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="section current-focus-section" aria-labelledby="current-focus-title">
      <div class="section-head">
        <h2 id="current-focus-title">Current focus</h2>
        <a class="section-kicker" href={withBase('/research')}>Research →</a>
      </div>
      <div class="current-focus-card">
        <strong>Inventory systems with replacement warranty</strong>
        <p>I am currently thinking about how uncertainty in warranty failures changes the information needed for decisions, the policy structure we can still justify, and the role of computational approximation.</p>
        <div class="current-focus-meta"><span>inventory theory</span><span>stochastic optimization</span><span>paper reading</span></div>
      </div>
    </section>

    {ideas.length > 0 && (
      <section class="section" aria-labelledby="ideas-motion-title">
        <div class="section-head">
          <h2 id="ideas-motion-title"><span class="ui-copy-en">Ideas in motion</span><span class="ui-copy-zh">正在推进的想法</span></h2>
          <div class="home-ideas-actions">
            <a class="section-kicker" href={withBase('/ideas')}><span class="ui-copy-en">Open studio →</span><span class="ui-copy-zh">进入工作台 →</span></a>
          </div>
        </div>
        <div class="home-ideas-preview">
          {ideas.map(idea => (
            <a class="home-idea-row" href={withBase(`/ideas/?open=${encodeURIComponent(idea.id)}`)}>
              <div>
                <small><span class="ui-copy-en">{idea.data.area} · {idea.data.stage}</span><span class="ui-copy-zh">{areaZh[idea.data.area]} · {stageZh[idea.data.stage]}</span></small><br/>
                <strong><span class="ui-copy-en">{idea.data.title}</span><span class="ui-copy-zh">{idea.data.titleZh || idea.data.title}</span></strong>
              </div>
              <span class="home-idea-next">
                {idea.data.nextAction ? <><span class="ui-copy-en">Next: {idea.data.nextAction}</span><span class="ui-copy-zh">下一步：{idea.data.nextActionZh || idea.data.nextAction}</span></> : <><span class="ui-copy-en">{idea.data.summary}</span><span class="ui-copy-zh">{idea.data.summaryZh || idea.data.summary}</span></>}
              </span>
              <span class="home-idea-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <h2>Recent Notes</h2>
        <a class="section-kicker" href={withBase('/notes')}>View all notes →</a>
      </div>
      {recent.length ? <NoteList notes={recent} /> : <p class="muted">No notes yet.</p>}
    </section>

    {site.github && (
      <section class="section github-activity-section" aria-labelledby="github-activity-title">
        <div class="section-head">
          <h2 id="github-activity-title"><span class="ui-copy-en">GitHub Activity</span><span class="ui-copy-zh">GitHub 更新热图</span></h2>
          <a class="section-kicker" href={site.github}><span class="ui-copy-en">View profile →</span><span class="ui-copy-zh">查看主页 →</span></a>
        </div>
        <a class="github-activity-card github-calendar-card" href={site.github} aria-label={`View ${site.fullName}'s GitHub profile`}>
          <div class="github-calendar" data-github-calendar data-github-username={githubUsername}>
            <div class="github-calendar-head">
              <span data-github-calendar-total><span class="ui-copy-en">Loading contribution data…</span><span class="ui-copy-zh">正在读取贡献数据……</span></span>
              <small><span class="ui-copy-en">GitHub profile data · site-styled</span><span class="ui-copy-zh">GitHub 主页数据 · 本站样式</span></small>
            </div>
            <div class="github-calendar-scroll">
              <div class="github-calendar-canvas" data-github-calendar-canvas aria-label="GitHub contribution calendar">
                <div class="github-calendar-months" data-github-calendar-months></div>
                <div class="github-calendar-weekdays" aria-hidden="true">
                  <span style="grid-row:2">Mon</span>
                  <span style="grid-row:4">Wed</span>
                  <span style="grid-row:6">Fri</span>
                </div>
                <div class="github-calendar-grid" data-github-calendar-grid></div>
              </div>
            </div>
            <div class="github-calendar-foot">
              <span data-github-calendar-freshness><span class="ui-copy-en">Contribution levels follow GitHub's public profile data.</span><span class="ui-copy-zh">贡献等级跟随 GitHub 公开主页数据。</span></span>
              <span class="github-calendar-legend" aria-label="Contribution intensity legend">
                <small><span class="ui-copy-en">Less</span><span class="ui-copy-zh">少</span></small>
                <i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
                <small><span class="ui-copy-en">More</span><span class="ui-copy-zh">多</span></small>
              </span>
            </div>
          </div>
          <span class="github-activity-note"><span class="ui-copy-en">Past-year public contributions · source refreshed about hourly.</span><span class="ui-copy-zh">过去一年的公开贡献 · 数据源约每小时刷新。</span></span>
        </a>
      </section>
    )}

    <VisitorAnalytics compact />
  </main>
  <SiteExtras />

  <script is:inline>
    (() => {
      const calendar = document.querySelector('[data-github-calendar]');
      if (!calendar) return;
      const username = calendar.dataset.githubUsername;
      const grid = calendar.querySelector('[data-github-calendar-grid]');
      const months = calendar.querySelector('[data-github-calendar-months]');
      const totalNode = calendar.querySelector('[data-github-calendar-total]');
      const freshness = calendar.querySelector('[data-github-calendar-freshness]');
      let contributions = null;
      let total = 0;

      const language = () => window.__kaizeUi?.language === 'zh' ? 'zh' : 'en';
      const t = (en, zh) => language() === 'zh' ? zh : en;
      const parseDate = value => new Date(`${value}T00:00:00Z`);

      const render = () => {
        if (!contributions?.length || !grid || !months) return;
        grid.replaceChildren();
        months.replaceChildren();

        const first = parseDate(contributions[0].date);
        const offset = first.getUTCDay();
        const weeks = Math.ceil((offset + contributions.length) / 7);
        calendar.style.setProperty('--github-weeks', String(weeks));
        calendar.style.setProperty('--github-grid-width', `${Math.max(680, weeks * 13 - 3)}px`);
        grid.style.gridTemplateColumns = `repeat(${weeks}, 10px)`;
        months.style.gridTemplateColumns = `repeat(${weeks}, 10px)`;

        let lastMonth = -1;
        contributions.forEach((entry, index) => {
          const date = parseDate(entry.date);
          const absolute = offset + index;
          const column = Math.floor(absolute / 7) + 1;
          const row = (absolute % 7) + 1;
          const cell = document.createElement('span');
          const count = Number(entry.count || 0);
          const level = Math.max(0, Math.min(4, Number(entry.level || 0)));
          cell.className = 'github-calendar-cell';
          cell.dataset.level = String(level);
          cell.style.gridColumn = String(column);
          cell.style.gridRow = String(row);
          cell.title = t(`${count} contribution${count === 1 ? '' : 's'} on ${entry.date}`, `${entry.date} · ${count} 次贡献`);
          cell.setAttribute('aria-label', cell.title);
          grid.appendChild(cell);

          const month = date.getUTCMonth();
          if (month !== lastMonth && (index === 0 || date.getUTCDate() <= 7)) {
            lastMonth = month;
            const label = document.createElement('span');
            label.style.gridColumn = `${column} / span 4`;
            label.textContent = new Intl.DateTimeFormat(language() === 'zh' ? 'zh-CN' : 'en', { month: 'short', timeZone: 'UTC' }).format(date);
            months.appendChild(label);
          }
        });

        if (totalNode) totalNode.textContent = t(`${total.toLocaleString()} contributions in the past year`, `过去一年 ${total.toLocaleString()} 次贡献`);
        if (freshness) freshness.textContent = t('Contribution levels follow GitHub public profile data · refreshed about hourly.', '贡献等级跟随 GitHub 公开主页数据 · 约每小时刷新。');
        calendar.classList.add('is-ready');
        calendar.classList.remove('is-error');
      };

      const load = async () => {
        try {
          const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(username)}?y=last`, { cache: 'no-store' });
          if (!response.ok) throw new Error(`GitHub contribution data ${response.status}`);
          const data = await response.json();
          contributions = Array.isArray(data?.contributions) ? data.contributions : [];
          total = Number(data?.total?.lastYear);
          if (!Number.isFinite(total)) total = contributions.reduce((sum, item) => sum + Number(item.count || 0), 0);
          if (!contributions.length) throw new Error('No contribution data');
          render();
        } catch (error) {
          calendar.classList.add('is-error');
          if (totalNode) totalNode.textContent = t('GitHub calendar temporarily unavailable', 'GitHub 热图暂时无法读取');
          if (freshness) freshness.textContent = t('Open the GitHub profile to see the current contribution graph.', '可以点击打开 GitHub 主页查看当前贡献图。');
          console.warn('[github-calendar]', error);
        }
      };

      document.addEventListener('kaize:ui-language', render);
      load();
    })();
  </script>
</BaseLayout>
