---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteList from '@/components/NoteList.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { getPublishedNotes } from '@/utils/notes';

export async function getStaticPaths() {
  const all = await getPublishedNotes();
  const categories = [
    { slug: 'research', label: 'Research' },
    { slug: 'paper-reading', label: 'Paper Reading' },
    { slug: 'learning', label: 'Learning' },
    { slug: 'essay', label: 'Essay' }
  ] as const;
  return categories.map(category => ({
    params: { category: category.slug },
    props: {
      title: category.label,
      notes: all.filter(note => note.data.category === category.label)
    }
  }));
}
const { title, notes } = Astro.props;
---
<BaseLayout title={`${title} Notes`} active="Notes">
  <main class="site-shell">
    <header class="page-hero"><div class="eyebrow">Notes / Category</div><h1>{title}</h1><p>{notes.length} note{notes.length === 1 ? '' : 's'} in this shelf.</p></header>
    <section class="section"><NoteList notes={notes} /></section>
  </main>
  <SiteExtras />
</BaseLayout>
