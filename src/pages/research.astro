---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import { site } from '@/site.config';
---
<BaseLayout title="Research" active="Research">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Academic</div>
      <h1>Research</h1>
      <p>My current work is centered on inventory systems with warranty and sequential decisions under uncertainty.</p>
    </header>

    <section class="section" id="current-work" aria-labelledby="current-work-title">
      <div class="section-head"><h2 id="current-work-title">Current work</h2></div>
      <div class="about-copy">
        <p>My main research interest is inventory management with replacement warranty, where service demand generated by product failures interacts with replenishment decisions over time.</p>
        <p>I am particularly interested in how uncertainty changes the information that a decision maker should retain, what policy structure remains available, and when computational approximation becomes useful.</p>
      </div>
    </section>

    <section class="section" id="areas" aria-labelledby="research-areas-title">
      <div class="section-head"><h2 id="research-areas-title">Research areas</h2></div>
      <div class="research-grid">
        {site.researchAreas.map((area,i) => <article class="research-card"><span class="num">0{i+1}</span><h3>{area.name}</h3><p>{area.description}</p></article>)}
      </div>
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
