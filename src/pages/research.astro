---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import '@/styles/knowledge.css';
import { site } from '@/site.config';
import { getPublishedNotes, formatDate, noteSlug } from '@/utils/notes';
import { withBase } from '@/utils/url';

const notes = await getPublishedNotes();
const trailNotes = notes
  .filter(note => note.data.category === 'Research' || note.data.category === 'Reading')
  .sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf())
  .slice(-10);
---
<BaseLayout title="Research" active="Research">
  <main class="site-shell">
    <header class="page-hero">
      <div class="eyebrow">Academic</div>
      <h1>Research</h1>
      <p>My current work is centered on inventory systems with warranty and sequential decisions under uncertainty. This page stays focused on research areas and the public trail of ideas as they develop.</p>
    </header>

    <section class="section">
      <div class="section-head"><h2>Research Interests</h2></div>
      <div class="research-grid">
        {site.researchAreas.map((area,i) => <article class="research-card"><span class="num">0{i+1}</span><h3>{area.name}</h3><p>{area.description}</p></article>)}
      </div>
    </section>

    {trailNotes.length > 0 && (
      <section class="section" aria-labelledby="research-trail-title">
        <div class="section-head"><h2 id="research-trail-title">Research Trail</h2><span class="section-kicker">Built from public notes, not a CV</span></div>
        <div class="research-trail">
          {trailNotes.map(note => (
            <div class="trail-item">
              <time class="trail-date">{formatDate(note.data.publishDate)}</time>
              <span class="trail-dot" aria-hidden="true"></span>
              <div class="trail-copy">
                <a href={withBase(`/notes/${noteSlug(note.id)}/`)}><strong>{note.data.title}</strong></a>
                <span>{note.data.category}{note.data.collection ? ` · ${note.data.collection}` : ''} · {note.data.lang === 'zh' ? '中文' : 'EN'}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="research-tools-title">
      <div class="section-head"><h2 id="research-tools-title">Research Tools</h2><span class="section-kicker">Use when needed</span></div>
      <div class="research-tool-links">
        <a href={withBase('/questions')}><strong>Questions Board</strong><span>Track questions that are explicitly worth carrying forward.</span></a>
        <a href={withBase('/sandbox')}><strong>Research Sandbox</strong><span>Small interactive sketches for mechanism intuition, separate from formal evidence.</span></a>
      </div>
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
