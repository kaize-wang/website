---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteExtras from '@/components/SiteExtras.astro';
import '@/styles/research-primer.css';
import { site } from '@/site.config';
import { withBase } from '@/utils/url';

const areaRoutes = [
  {
    ...site.researchAreas[0],
    index: '01',
    slug: 'inventory-warranty',
    nameZh: '库存与保修',
    descriptionZh: '研究替换保修产生的未来服务需求如何改变库存决策，以及决策者究竟需要保留哪些关于在保产品群体的信息。',
    label: 'Installed base · failures · service demand',
    labelZh: '在保群体 · 失效 · 保修需求'
  },
  {
    ...site.researchAreas[1],
    index: '02',
    slug: 'stochastic-optimization',
    nameZh: '随机优化',
    descriptionZh: '研究不确定环境下的动态决策，重点关注状态设计、策略结构，以及精确计算与近似计算之间的边界。',
    label: 'State · uncertainty · dynamic decisions',
    labelZh: '状态 · 不确定性 · 动态决策'
  },
  {
    ...site.researchAreas[2],
    index: '03',
    slug: 'operations-research',
    nameZh: '运筹学',
    descriptionZh: '用模型、概率与算法理解序贯决策、库存控制及相关运营系统，并把理论结果转化为可解释的决策规则。',
    label: 'Models · algorithms · operational systems',
    labelZh: '模型 · 算法 · 运营系统'
  }
];
---
<BaseLayout title="Research" active="Research">
  <main class="site-shell research-overview-page">
    <header class="page-hero">
      <div class="eyebrow"><span class="ui-copy-en">Academic · current work</span><span class="ui-copy-zh">学术 · 当前研究</span></div>
      <h1>Research</h1>
      <p>
        <span class="ui-copy-en">My current work is centered on inventory systems with warranty and sequential decisions under uncertainty.</span>
        <span class="ui-copy-zh">我目前主要关注带保修的库存系统，以及不确定环境下的序贯决策问题。</span>
      </p>
      <nav class="research-constellation" aria-label="Research area map">
        {areaRoutes.map(area => (
          <a href={withBase(`/research/${area.slug}`)}>
            <b>{area.index}</b>
            <span><span class="ui-copy-en">{area.name}</span><span class="ui-copy-zh">{area.nameZh}</span></span>
          </a>
        ))}
      </nav>
    </header>

    <section class="section" id="current-work" aria-labelledby="current-work-title">
      <div class="section-head">
        <h2 id="current-work-title"><span class="ui-copy-en">Current work</span><span class="ui-copy-zh">当前工作</span></h2>
        <span class="section-kicker"><span class="ui-copy-en">Warranty → state → policy</span><span class="ui-copy-zh">保修 → 状态 → 策略</span></span>
      </div>
      <div class="research-current-grid">
        <div class="about-copy">
          <p>
            <span class="ui-copy-en">My main research interest is inventory management with replacement warranty, where service demand generated by product failures interacts with replenishment decisions over time.</span>
            <span class="ui-copy-zh">我最主要的研究兴趣是替换保修下的库存管理：产品失效会不断产生售后替换需求，而这些需求又与库存补货决策在时间上相互耦合。</span>
          </p>
          <p>
            <span class="ui-copy-en">I am particularly interested in how uncertainty changes the information that a decision maker should retain, what policy structure remains available, and when computational approximation becomes useful.</span>
            <span class="ui-copy-zh">我尤其关心三件事：不确定性会让决策者必须保留哪些信息；还能否得到有结构的最优策略；以及什么时候需要借助数值方法和函数近似。</span>
          </p>
        </div>
        <aside class="research-current-aside">
          <span><span class="ui-copy-en">Questions I keep returning to</span><span class="ui-copy-zh">我反复追问的问题</span></span>
          <ul>
            <li><span class="ui-copy-en">What is the smallest state that still preserves the decision problem?</span><span class="ui-copy-zh">怎样找到既足够、又尽可能紧凑的状态表示？</span></li>
            <li><span class="ui-copy-en">Which monotonicity, convexity, or threshold structures survive uncertainty?</span><span class="ui-copy-zh">在不确定性下，哪些单调性、凸性或阈值结构仍然成立？</span></li>
            <li><span class="ui-copy-en">When does exact dynamic programming give way to approximation?</span><span class="ui-copy-zh">什么时候精确动态规划已经不现实，必须转向近似？</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section" id="areas" aria-labelledby="research-areas-title">
      <div class="section-head">
        <h2 id="research-areas-title"><span class="ui-copy-en">Research areas</span><span class="ui-copy-zh">研究领域</span></h2>
        <span class="section-kicker"><span class="ui-copy-en">Open a field primer →</span><span class="ui-copy-zh">点进去看详细科普 →</span></span>
      </div>
      <div class="research-grid">
        {areaRoutes.map(area => (
          <a class="research-card research-area-card" href={withBase(`/research/${area.slug}`)}>
            <div class="research-card-kicker"><span>{area.index}</span><i></i></div>
            <h3><span class="ui-copy-en">{area.name}</span><span class="ui-copy-zh">{area.nameZh}</span></h3>
            <p><span class="ui-copy-en">{area.description}</span><span class="ui-copy-zh">{area.descriptionZh}</span></p>
            <span class="research-card-open">
              <span class="ui-copy-en">{area.label}</span>
              <span class="ui-copy-zh">{area.labelZh}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <SiteExtras />
</BaseLayout>
