---
import '@/styles/experiments.css';
import '@/styles/visitor-analytics.css';
import { withBase } from '@/utils/url';
const { compact = false } = Astro.props as { compact?: boolean };
const mapId = '1788163702';
const mapImage = `https://smallcounter.com/map/view.php?type=180&id=${mapId}`;
const mapDetails = `https://smallcounter.com/vmap/${mapId}/`;
---
{compact ? (
  <section class="section visitor-summary-section" id="visitors">
    <div class="section-head">
      <h2>Visitors</h2>
      <a class="section-kicker" href={withBase('/about#visitors')}>Explore visitor map →</a>
    </div>
    <div class="visitor-summary-card">
      <div class="visitor-summary-stats" aria-label="Lightweight website visit statistics">
        <div><strong id="busuanzi_site_pv">—</strong><span>page views</span></div>
        <div><strong id="busuanzi_site_uv">—</strong><span>visitors</span></div>
        <div><strong id="busuanzi_today_pv">—</strong><span>today views</span></div>
        <div><strong id="busuanzi_today_uv">—</strong><span>today visitors</span></div>
      </div>
      <a class="external-visitor-map-link visitor-map-compact" href={withBase('/about#visitors')} aria-label="Open the full visitor map">
        <img class="external-visitor-map" src={mapImage} alt="World map showing approximate visitor locations" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" />
        <span class="external-map-fallback" hidden>Visitor map is temporarily unavailable.</span>
      </a>
    </div>
    <p class="visitor-summary-note">No account or analytics dashboard. Counts are supplied by Busuanzi; the map is a lightweight SmallCounter embed.</p>
  </section>
) : (
  <div class="experiment-card visitor-analytics-card" id="visitors">
    <div class="experiment-kicker">Visitor map</div>
    <h3>Where this site is being read</h3>
    <p class="experiment-intro">A deliberately simple public counter: Busuanzi supplies site/page visit totals, while SmallCounter draws the geographic visitor map. There is no account, API key, private dashboard, or server to maintain.</p>

    <div class="visitor-live-stats" aria-label="Website visit statistics">
      <div><strong id="busuanzi_site_pv">—</strong><span>Page views</span></div>
      <div><strong id="busuanzi_site_uv">—</strong><span>Visitors</span></div>
      <div><strong id="busuanzi_today_pv">—</strong><span>Today views</span></div>
      <div><strong id="busuanzi_today_uv">—</strong><span>Today visitors</span></div>
    </div>

    <a class="external-visitor-map-link visitor-map-full" href={mapDetails} target="_blank" rel="noreferrer" aria-label="Open detailed visitor map statistics">
      <img class="external-visitor-map" src={mapImage} alt="World map showing approximate visitor locations" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" />
      <span class="external-map-fallback" hidden>Visitor map is temporarily unavailable.</span>
    </a>

    <div class="visitor-privacy-note">
      <strong>Simple by design.</strong>
      <span>The public counters may not match professional analytics exactly. The map uses the visitor request to infer an approximate location; this site does not run its own IP database or expose visitor IP addresses. Click the map to open SmallCounter's detailed map page.</span>
    </div>
  </div>
)}

<script is:inline>
(() => {
  document.querySelectorAll('.external-visitor-map').forEach((image) => {
    image.addEventListener('error', () => {
      image.hidden = true;
      const fallback = image.parentElement?.querySelector('.external-map-fallback');
      if (fallback) fallback.hidden = false;
    }, { once: true });
  });
})();
</script>
