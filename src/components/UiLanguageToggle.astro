  ]);
  const reverse = new Map([...exact.entries()].map(([en, zh]) => [zh, en]));

  const zoneSelector = [
    '.site-sidebar', '.context-nav-wrap', '.site-footer', '.command-palette',
    '.hero-banner', '.profile-grid', '.current-focus-section', '.home-ideas-preview',
    '.page-hero', '.section-head', '.knowledge-links', '.ideas-page', '.idea-detail-shell',
    '.note-shelf-guide', '.current-focus-meta', '.lab-page .explore-grid',
    '.research-grid', '.about-copy', '.sandbox-purpose',
    '.visitor-summary-section', '.visitor-detail-section',
    'label[for="q"]', '.smart-search-input', '#search-summary', '.smart-search-results',
    '.paper-reading-open', '.article-toolbox', '.resume-reading', '.article-contents',
    '.reference-section > h2', '.floating-toc', '.empty-research-tool',
    'button', 'summary', '.sidenote-label', '.math-copy-button'
  ].join(',');

  const isUiNode = node => {
    const parent = node?.parentElement;
    if (!parent) return false;
    if (parent.matches('pre, code, script, style')) return false;
    if (parent.closest('.prose') && !parent.closest('.sidenote-label, .math-copy-button')) return false;
    return Boolean(parent.closest(zoneSelector));
  };

  const preserveSpace = (original, translated) => {
    const leading = original.match(/^\s*/)?.[0] || '';
    const trailing = original.match(/\s*$/)?.[0] || '';
    return `${leading}${translated}${trailing}`;
  };

  const dynamicTranslate = (value, lang) => {
    const text = String(value || '').trim();
    if (!text) return value;
    const direct = lang === 'zh' ? exact.get(text) : reverse.get(text);
    if (direct) return preserveSpace(value, direct);

    if (lang === 'zh') {
      let match = text.match(/^(\d+) result(?:s)?(?: for “(.+)”)?$/);
      if (match) return preserveSpace(value, `${match[1]} 个结果${match[2] ? ` · “${match[2]}”` : ''}`);
      match = text.match(/^(\d+) sections$/);
      if (match) return preserveSpace(value, `${match[1]} 个章节`);
      match = text.match(/^(\d+) papers$/);
      if (match) return preserveSpace(value, `${match[1]} 篇论文`);
      match = text.match(/^(\d+) notes$/);
      if (match) return preserveSpace(value, `${match[1]} 篇笔记`);
      match = text.match(/^(\d+) ideas$/);
      if (match) return preserveSpace(value, `${match[1]} 个想法`);
      match = text.match(/^(\d+) wiki links$/);
      if (match) return preserveSpace(value, `${match[1]} 个 Wiki 链接`);
      match = text.match(/^(\d+) series$/);
      if (match) return preserveSpace(value, `${match[1]} 个系列`);
      match = text.match(/^(\d+) reading notes$/);
      if (match) return preserveSpace(value, `${match[1]} 篇阅读笔记`);
      match = text.match(/^(\d+) questions$/);
      if (match) return preserveSpace(value, `${match[1]} 个问题`);
      match = text.match(/^You previously reached about (\d+)% of this note\.$/);
      if (match) return preserveSpace(value, `你上次读到这篇笔记约 ${match[1]}%。`);
    } else {
      let match = text.match(/^(\d+) 个结果(?: · “(.+)”)?$/);
      if (match) return preserveSpace(value, `${match[1]} result${match[1] === '1' ? '' : 's'}${match[2] ? ` for “${match[2]}”` : ''}`);
      match = text.match(/^(\d+) 个章节$/);
      if (match) return preserveSpace(value, `${match[1]} sections`);
      match = text.match(/^(\d+) 篇论文$/);
      if (match) return preserveSpace(value, `${match[1]} papers`);
      match = text.match(/^(\d+) 篇笔记$/);
      if (match) return preserveSpace(value, `${match[1]} notes`);
      match = text.match(/^(\d+) 个想法$/);
      if (match) return preserveSpace(value, `${match[1]} ideas`);
      match = text.match(/^(\d+) 个 Wiki 链接$/);
      if (match) return preserveSpace(value, `${match[1]} wiki links`);
      match = text.match(/^(\d+) 个系列$/);
      if (match) return preserveSpace(value, `${match[1]} series`);
      match = text.match(/^(\d+) 篇阅读笔记$/);
      if (match) return preserveSpace(value, `${match[1]} reading notes`);
      match = text.match(/^(\d+) 个问题$/);
      if (match) return preserveSpace(value, `${match[1]} questions`);
      match = text.match(/^你上次读到这篇笔记约 (\d+)% 。?$/);
      if (match) return preserveSpace(value, `You previously reached about ${match[1]}% of this note.`);
    }
    return value;
  };

  const translateAttributes = (element, lang) => {
    if (!(element instanceof Element)) return;
    ['placeholder', 'title', 'aria-label'].forEach(attr => {
      const current = element.getAttribute(attr);
      if (!current) return;
      const translated = dynamicTranslate(current, lang).trim();
      if (translated !== current) element.setAttribute(attr, translated);
    });
  };

  let applying = false;
  const apply = (root = document) => {
    if (applying) return;
    applying = true;
    const lang = document.documentElement.dataset.uiLanguage === 'zh' ? 'zh' : 'en';
    const roots = root instanceof Element || root instanceof Document ? [root] : [];
    roots.forEach(target => {
      if (target instanceof Element) translateAttributes(target, lang);
      target.querySelectorAll?.('*').forEach(element => {
        if (element.closest(zoneSelector)) translateAttributes(element, lang);
      });
      const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
      const nodes = [];
      let node;
      while ((node = walker.nextNode())) if (isUiNode(node)) nodes.push(node);
      nodes.forEach(textNode => {
        const translated = dynamicTranslate(textNode.nodeValue || '', lang);
        if (translated !== textNode.nodeValue) textNode.nodeValue = translated;
      });
    });
    applying = false;
  };

  const setLanguage = lang => {
    const next = lang === 'zh' ? 'zh' : 'en';
    document.documentElement.dataset.uiLanguage = next;
    document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
    try { localStorage.setItem('kaize-ui-language', next); } catch {}
    apply(document);
    document.dispatchEvent(new CustomEvent('kaize:ui-language', { detail: { language: next } }));
  };

  window.__kaizeUi = {
    get language() { return document.documentElement.dataset.uiLanguage === 'zh' ? 'zh' : 'en'; },
    t(en, zh) { return this.language === 'zh' ? zh : en; },
    apply,
    setLanguage
  };

  const toggle = document.getElementById('ui-language-toggle');
  toggle?.addEventListener('click', () => setLanguage(window.__kaizeUi.language === 'zh' ? 'en' : 'zh'));

  const observer = new MutationObserver(mutations => {
    if (applying) return;
    mutations.forEach(mutation => {
      if (mutation.type === 'characterData') {
        if (isUiNode(mutation.target)) {
          const translated = dynamicTranslate(mutation.target.nodeValue || '', window.__kaizeUi.language);
          if (translated !== mutation.target.nodeValue) mutation.target.nodeValue = translated;
        }
      } else {
        mutation.addedNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE) apply(node);
          else if (node.nodeType === Node.TEXT_NODE && isUiNode(node)) {
            const translated = dynamicTranslate(node.nodeValue || '', window.__kaizeUi.language);
            if (translated !== node.nodeValue) node.nodeValue = translated;
          }
        });
      }
    });
  });

  apply(document);
  observer.observe(document.documentElement, { subtree: true, childList: true, characterData: true });
})();
</script>
