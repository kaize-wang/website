<button class="ui-language-toggle" id="ui-language-toggle" type="button" aria-label="Switch interface language" title="Switch interface language">
  <span class="ui-language-option ui-lang-zh">中</span><span class="ui-language-divider">/</span><span class="ui-language-option ui-lang-en">EN</span>
</button>

<script is:inline>
(() => {
  const exact = new Map([
    ['Academic homepage', '学术主页'],
    ['Home', '首页'],
    ['Research', '研究'],
    ['Notes', '笔记'],
    ['About', '关于'],
    ['Search', '搜索'],
    ['Overview', '概览'],
    ['Questions', '问题'],
    ['Questions Board', '研究问题'],
    ['Sandbox', '沙盒'],
    ['Research Sandbox', '研究沙盒'],
    ['All Notes', '全部笔记'],
    ['Paper Reading', '论文阅读'],
    ['Knowledge Graph', '知识图谱'],
    ['Literature Map', '文献图谱'],
    ['Archive', '归档'],
    ['Quick search', '快速搜索'],
    ['Research · Notes · Writing', '研究 · 笔记 · 写作'],
    ['← Back to Home', '← 返回首页'],
    ['← Back to Research', '← 返回研究'],
    ['← Back to Notes', '← 返回笔记'],
    ['Built with Astro · writing stays in Markdown', '使用 Astro 构建 · 写作保持 Markdown'],
    ['Search kaizewang', '搜索 kaizewang'],
    ['No matching pages or notes.', '没有匹配的页面或笔记。'],
    ['No matching notes.', '没有匹配的笔记。'],
    ['↑ ↓ navigate', '↑ ↓ 选择'],
    ['↵ open', '↵ 打开'],
    ['Page', '页面'],
    ['Map', '图谱'],
    ['Papers', '论文'],
    ['Note', '笔记'],
    ['Full-text search', '全文搜索'],
    ['Research Interests', '研究方向'],
    ['Research Trail', '研究轨迹'],
    ['Working Papers & Publications', '工作论文与发表'],
    ['Explore the notebook', '探索笔记网络'],
    ['Reading desk', '阅读工作台'],
    ['Reading notes ↔ papers', '阅读笔记 ↔ 论文'],
    ['Question states', '问题状态'],
    ['Mechanism sketch', '机制草图'],
    ['Time machine', '时间机器'],
    ['All published notes', '全部已发布笔记'],
    ['Find path', '寻找路径'],
    ['Constellation', '星图模式'],
    ['Connect two ideas', '连接两个想法'],
    ['Hover a node to inspect its neighborhood.', '悬停节点查看它的邻接关系。'],
    ['Wiki link', 'Wiki 链接'],
    ['Same series', '同一专栏'],
    ['Shared tags / citation', '共同标签 / 引用'],
    ['Reading note', '阅读笔记'],
    ['Paper / reference', '论文 / 参考文献'],
    ['Recorded reading or citation relation', '已记录的阅读或引用关系'],
    ['All', '全部'],
    ['Due', '到期'],
    ['Reading', '在读'],
    ['Read', '已读'],
    ['Revisit', '重读'],
    ['Core', '核心'],
    ['No local revisit schedule.', '尚未安排本地重读。'],
    ['Reviewed today · +30d', '今天已重读 · +30天'],
    ['Clear', '清除'],
    ['Copy link', '复制链接'],
    ['Copied', '已复制'],
    ['Copy failed', '复制失败'],
    ['Copy', '复制'],
    ['Failed', '失败'],
    ['Cite', '引用'],
    ['Cite this note', '引用这篇笔记'],
    ['Plain', '纯文本'],
    ['Academic', '学术模式'],
    ['Exit academic', '退出学术模式'],
    ['Print', '打印'],
    ['Focus', '专注阅读'],
    ['Exit focus', '退出专注阅读'],
    ['Wander →', '漫游 →'],
    ['views', '次浏览'],
    ['Resume where you left off?', '继续上次的阅读位置？'],
    ['Resume reading →', '继续阅读 →'],
    ['Contents', '目录'],
    ['References', '参考文献'],
    ['Referenced by', '被这些笔记引用'],
    ['Related notes', '相关笔记'],
    ['Your reaction', '你的反馈'],
    ['Useful', '有用'],
    ['Interesting', '有意思'],
    ['Comments', '评论'],
    ['Outline', '目录'],
    ['Notation', '符号'],
    ['Assumptions', '假设'],
    ['On this page', '本页目录'],
    ['No notation blocks found.', '没有找到符号块。'],
    ['No assumption blocks found.', '没有找到假设块。'],
    ['Side note', '侧注'],
    ['Copy TeX', '复制 TeX'],
    ['Source ↗', '来源 ↗'],
    ['Open paper ↗', '打开论文 ↗'],
    ['English summary', '英文摘要'],
    ['Use it for', '适合用来'],
    ['Do not read it as', '不要把它当作'],
    ['Mechanism intuition', '机制直觉'],
    ['Research evidence', '研究证据'],
    ['Close search', '关闭搜索'],
    ['Toggle light and dark theme', '切换明暗主题'],
    ['Back to top', '返回顶部'],
    ['Main navigation', '主导航'],
    ['Search results', '搜索结果'],
    ['Switch interface language', '切换界面语言'],
    ['Close citation dialog', '关闭引用窗口'],
    ['Close expanded figure', '关闭大图'],
    ['Expanded figure', '放大的图片']
  ]);
  const reverse = new Map([...exact.entries()].map(([en, zh]) => [zh, en]));

  const zoneSelector = [
    '.site-sidebar', '.context-nav-wrap', '.site-footer', '.command-palette',
    '.page-hero h1', '.page-hero .eyebrow', '.category-nav', '.knowledge-links',
    '.section-head', '.paper-status-filter', '.revisit-overview', '.revisit-panel',
    '.graph-controls', '.graph-status', '.graph-legend', '.graph-note',
    '.article-toolbox', '.resume-reading', '.article-contents',
    '.reference-section > h2', '.backlinks-section > h2', '.backlinks-note',
    '.related-notes-section > h2', '.article-reactions', '.comments-section',
    '.backline', '.floating-toc', '.cite-dialog', '.sandbox-purpose',
    '.search-filter-hints', 'label[for="q"]', '.search-summary',
    'button', 'summary', '.sidenote-label', '.math-copy-button'
  ].join(',');

  const excluded = '.prose:not(:has(.sidenote-label)):not(:has(.math-copy-button)), .article-desc, .note-title, .note-desc, pre, code, script, style';
  const isUiNode = node => {
    const parent = node?.parentElement;
    if (!parent) return false;
    if (parent.matches('pre, code, script, style')) return false;
    if (parent.closest('.prose') && !parent.closest('.sidenote-label, .math-copy-button')) return false;
    return Boolean(parent.closest(zoneSelector));
  };

  const preserveSpace = (original, translated) => {
    const leading = original.match(/^\s*/)?.[0] || '';
    const trailing = original.match(/\s*$/)?.[0] || '';
    return `${leading}${translated}${trailing}`;
  };

  const dynamicTranslate = (value, lang) => {
    const text = String(value || '').trim();
    if (!text) return value;
    const direct = lang === 'zh' ? exact.get(text) : reverse.get(text);
    if (direct) return preserveSpace(value, direct);

    if (lang === 'zh') {
      let match = text.match(/^(\d+) result(?:s)?(?: for “(.+)”)?$/);
      if (match) return preserveSpace(value, `${match[1]} 个结果${match[2] ? ` · “${match[2]}”` : ''}`);
      match = text.match(/^(\d+) notes visible at this point in time\.$/);
      if (match) return preserveSpace(value, `此时可见 ${match[1]} 篇笔记。`);
      match = text.match(/^You previously reached about (\d+)% of this note\.$/);
      if (match) return preserveSpace(value, `你上次读到这篇笔记约 ${match[1]}%。`);
      match = text.match(/^(\d+) sections$/);
      if (match) return preserveSpace(value, `${match[1]} 个章节`);
      match = text.match(/^(\d+) notes$/);
      if (match) return preserveSpace(value, `${match[1]} 篇笔记`);
      match = text.match(/^(\d+) wiki links$/);
      if (match) return preserveSpace(value, `${match[1]} 条 Wiki 链接`);
      match = text.match(/^(\d+) series$/);
      if (match) return preserveSpace(value, `${match[1]} 个专栏`);
      match = text.match(/^(\d+) papers$/);
      if (match) return preserveSpace(value, `${match[1]} 篇论文`);
      match = text.match(/^(\d+) questions$/);
      if (match) return preserveSpace(value, `${match[1]} 个问题`);
      match = text.match(/^(\d+) reading notes$/);
      if (match) return preserveSpace(value, `${match[1]} 篇阅读笔记`);
      match = text.match(/^Shortest path: (.+)$/);
      if (match) return preserveSpace(value, `最短路径：${match[1]}`);
      match = text.match(/^Path: (.+)$/);
      if (match) return preserveSpace(value, `路径：${match[1]}`);
      match = text.match(/^Due now(?: · reviewed (.+))?$/);
      if (match) return preserveSpace(value, `现在该重读${match[1] ? ` · 上次 ${match[1]}` : ''}`);
      match = text.match(/^Due (.+?)(?: · reviewed (.+))?$/);
      if (match) return preserveSpace(value, `计划重读 ${match[1]}${match[2] ? ` · 上次 ${match[2]}` : ''}`);
      if (text === 'No relationship path exists yet. That gap may itself be useful.') return preserveSpace(value, '目前还没有关系路径；这个断点本身也可能值得关注。');
      if (text === 'Constellation mode: the graph is gently drifting.') return preserveSpace(value, '星图模式：节点正在轻微漂移。');
      if (text === 'Constellation mode paused.') return preserveSpace(value, '星图模式已暂停。');
      if (text === 'Constellation mode started after a quiet moment.') return preserveSpace(value, '静置一会儿后已进入星图模式。');
    } else {
      let match = text.match(/^(\d+) 个结果(?: · “(.+)”)?$/);
      if (match) return preserveSpace(value, `${match[1]} result${match[1] === '1' ? '' : 's'}${match[2] ? ` for “${match[2]}”` : ''}`);
      match = text.match(/^此时可见 (\d+) 篇笔记。$/);
      if (match) return preserveSpace(value, `${match[1]} notes visible at this point in time.`);
      match = text.match(/^你上次读到这篇笔记约 (\d+)%。$/);
      if (match) return preserveSpace(value, `You previously reached about ${match[1]}% of this note.`);
      match = text.match(/^(\d+) 个章节$/);
      if (match) return preserveSpace(value, `${match[1]} sections`);
      match = text.match(/^(\d+) 篇笔记$/);
      if (match) return preserveSpace(value, `${match[1]} notes`);
      match = text.match(/^(\d+) 条 Wiki 链接$/);
      if (match) return preserveSpace(value, `${match[1]} wiki links`);
      match = text.match(/^(\d+) 个专栏$/);
      if (match) return preserveSpace(value, `${match[1]} series`);
      match = text.match(/^(\d+) 篇论文$/);
      if (match) return preserveSpace(value, `${match[1]} papers`);
      match = text.match(/^(\d+) 个问题$/);
      if (match) return preserveSpace(value, `${match[1]} questions`);
      match = text.match(/^(\d+) 篇阅读笔记$/);
      if (match) return preserveSpace(value, `${match[1]} reading notes`);
      match = text.match(/^最短路径：(.+)$/);
      if (match) return preserveSpace(value, `Shortest path: ${match[1]}`);
      match = text.match(/^路径：(.+)$/);
      if (match) return preserveSpace(value, `Path: ${match[1]}`);
      match = text.match(/^现在该重读(?: · 上次 (.+))?$/);
      if (match) return preserveSpace(value, `Due now${match[1] ? ` · reviewed ${match[1]}` : ''}`);
      match = text.match(/^计划重读 (.+?)(?: · 上次 (.+))?$/);
      if (match) return preserveSpace(value, `Due ${match[1]}${match[2] ? ` · reviewed ${match[2]}` : ''}`);
      if (text === '目前还没有关系路径；这个断点本身也可能值得关注。') return preserveSpace(value, 'No relationship path exists yet. That gap may itself be useful.');
      if (text === '星图模式：节点正在轻微漂移。') return preserveSpace(value, 'Constellation mode: the graph is gently drifting.');
      if (text === '星图模式已暂停。') return preserveSpace(value, 'Constellation mode paused.');
      if (text === '静置一会儿后已进入星图模式。') return preserveSpace(value, 'Constellation mode started after a quiet moment.');
    }
    return value;
  };

  const translateAttributes = (element, lang) => {
    if (!(element instanceof Element)) return;
    ['placeholder', 'title', 'aria-label'].forEach(attr => {
      const current = element.getAttribute(attr);
      if (!current) return;
      const translated = dynamicTranslate(current, lang).trim();
      if (translated !== current) element.setAttribute(attr, translated);
    });
  };

  let applying = false;
  const apply = (root = document) => {
    if (applying) return;
    applying = true;
    const lang = document.documentElement.dataset.uiLanguage === 'zh' ? 'zh' : 'en';
    const roots = root instanceof Element || root instanceof Document ? [root] : [];
    roots.forEach(target => {
      if (target instanceof Element) translateAttributes(target, lang);
      target.querySelectorAll?.('*').forEach(element => {
        if (element.closest(zoneSelector)) translateAttributes(element, lang);
      });
      const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
      const nodes = [];
      let node;
      while ((node = walker.nextNode())) if (isUiNode(node)) nodes.push(node);
      nodes.forEach(textNode => {
        const translated = dynamicTranslate(textNode.nodeValue || '', lang);
        if (translated !== textNode.nodeValue) textNode.nodeValue = translated;
      });
    });
    applying = false;
  };

  const setLanguage = lang => {
    const next = lang === 'zh' ? 'zh' : 'en';
    document.documentElement.dataset.uiLanguage = next;
    document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
    try { localStorage.setItem('kaize-ui-language', next); } catch {}
    apply(document);
    document.dispatchEvent(new CustomEvent('kaize:ui-language', { detail: { language: next } }));
  };

  window.__kaizeUi = {
    get language() { return document.documentElement.dataset.uiLanguage === 'zh' ? 'zh' : 'en'; },
    t(en, zh) { return this.language === 'zh' ? zh : en; },
    apply,
    setLanguage
  };

  const toggle = document.getElementById('ui-language-toggle');
  toggle?.addEventListener('click', () => setLanguage(window.__kaizeUi.language === 'zh' ? 'en' : 'zh'));

  const observer = new MutationObserver(mutations => {
    if (applying) return;
    mutations.forEach(mutation => {
      if (mutation.type === 'characterData') {
        if (isUiNode(mutation.target)) {
          const lang = window.__kaizeUi.language;
          const translated = dynamicTranslate(mutation.target.nodeValue || '', lang);
          if (translated !== mutation.target.nodeValue) mutation.target.nodeValue = translated;
        }
      } else {
        mutation.addedNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE) apply(node);
          else if (node.nodeType === Node.TEXT_NODE && isUiNode(node)) {
            const translated = dynamicTranslate(node.nodeValue || '', window.__kaizeUi.language);
            if (translated !== node.nodeValue) node.nodeValue = translated;
          }
        });
      }
    });
  });

  apply(document);
  observer.observe(document.documentElement, { subtree: true, childList: true, characterData: true });
})();
</script>
