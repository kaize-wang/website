---
import PaperReaderWorkspace from '@/components/PaperReaderWorkspace.astro';
import '@/styles/article-reading-polish.css';
import { withBase } from '@/utils/url';

const isHuangReader = Astro.url.pathname.endsWith('/notes/paper-reading-huang-2008/');
const huangPdfParts = [1, 2, 3, 4].map(index => withBase(`/sources/huang-2008.pdf.b64.part${index}`));
const huangMarkdownParts = [1, 2, 3, 4, 5].map(index => withBase(`/sources/huang-2008.md.part${index}`));
---

{isHuangReader && (
  <PaperReaderWorkspace
    noteId="paper-reading-huang-2008"
    paperTitle="Managing the Inventory of an Item with a Replacement Warranty"
    pdfParts={huangPdfParts}
    markdownParts={huangMarkdownParts}
    printedPageStart={1441}
    pdfPageStart={1}
    appendixPrintedPageStart={29}
    appendixPdfPageStart={14}
  />
)}

<script is:inline>
(() => {
  const init = () => {
    if (!document.querySelector('[data-visitor-analytics]')) return;

    const COUNTER_BASE = 'https://countapi.mileshilliard.com/api/v1';
    const COUNTER_PREFIX = 'kaizewang-site-20260902-v1';
    const GEO_COUNTED_KEY = 'kaizewang:geo-counted:v1';
    const GEO_CACHE_KEY = 'kaizewang:geo-cache:v1';
    const REGION_CODES = ['NA', 'SA', 'EU', 'AF', 'AS', 'OC'];

    const counterRequest = async (action, key) => {
      try {
        const response = await fetch(`${COUNTER_BASE}/${action}/${COUNTER_PREFIX}-${key}`, { cache: 'no-store' });
        if (!response.ok) return 0;
        const data = await response.json();
        const value = Number(data?.value);
        return Number.isFinite(value) ? value : 0;
      } catch {
        return 0;
      }
    };
    const hitCounter = key => counterRequest('hit', key);
    const getCounter = key => counterRequest('get', key);

    const geoStats = { countriesReached: 0, regions: {} };
    const renderGeoStats = () => {
      document.querySelectorAll('[data-kaize-geo-stat="countriesReached"]').forEach(node => {
        node.textContent = geoStats.countriesReached > 0 ? geoStats.countriesReached.toLocaleString() : '—';
      });
      const values = REGION_CODES.map(code => Number(geoStats.regions?.[code] || 0));
      const maxRegion = Math.max(1, ...values);
      REGION_CODES.forEach(code => {
        const count = Number(geoStats.regions?.[code] || 0);
        document.querySelectorAll(`[data-region-dot="${code}"]`).forEach(node => {
          const radius = count ? 5 + 8 * Math.sqrt(count / maxRegion) : 0;
          node.setAttribute('r', radius.toFixed(1));
          node.classList.toggle('visible', count > 0);
        });
        document.querySelectorAll(`[data-region-halo="${code}"]`).forEach(node => {
          const radius = count ? 11 + 14 * Math.sqrt(count / maxRegion) : 0;
          node.setAttribute('r', radius.toFixed(1));
          node.classList.toggle('visible', count > 0);
        });
        document.querySelectorAll(`[data-region-count="${code}"]`).forEach(node => {
          node.textContent = count ? String(count) : '';
        });
        document.querySelectorAll(`[data-region-legend="${code}"]`).forEach(node => {
          node.textContent = count.toLocaleString();
        });
      });
    };

    const readCachedGeo = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(GEO_CACHE_KEY) || 'null');
        if (!cached || !cached.savedAt || Date.now() - cached.savedAt > 30 * 86400000) return null;
        return cached;
      } catch {
        return null;
      }
    };

    const fetchGeo = async () => {
      const cached = readCachedGeo();
      if (cached) return cached;
      try {
        const response = await fetch('https://ipwho.is/', { cache: 'no-store' });
        if (!response.ok) return null;
        const data = await response.json();
        if (data?.success === false) return null;
        const geo = {
          countryCode: String(data.country_code || '').toUpperCase(),
          continentCode: String(data.continent_code || '').toUpperCase(),
          savedAt: Date.now()
        };
        try { localStorage.setItem(GEO_CACHE_KEY, JSON.stringify(geo)); } catch {}
        return geo;
      } catch {
        return null;
      }
    };

    const countGeoOnce = async geo => {
      if (!geo) return;
      let alreadyCounted = false;
      try { alreadyCounted = localStorage.getItem(GEO_COUNTED_KEY) === '1'; } catch {}
      if (alreadyCounted) return;

      const regionCode = REGION_CODES.includes(geo.continentCode) ? geo.continentCode : '';
      if (regionCode) await hitCounter(`region-${regionCode.toLowerCase()}`);
      if (geo.countryCode) {
        const countryValue = await hitCounter(`country-${geo.countryCode.toLowerCase()}`);
        if (countryValue === 1) await hitCounter('countries-reached');
      }
      try { localStorage.setItem(GEO_COUNTED_KEY, '1'); } catch {}
    };

    const loadRegionStats = async () => {
      const regionPairs = await Promise.all(REGION_CODES.map(async code => [code, await getCounter(`region-${code.toLowerCase()}`)]));
      geoStats.regions = Object.fromEntries(regionPairs);
      geoStats.countriesReached = await getCounter('countries-reached');
      renderGeoStats();
    };

    const load = async () => {
      let counted = false;
      try { counted = localStorage.getItem(GEO_COUNTED_KEY) === '1'; } catch {}
      if (!counted) await countGeoOnce(await fetchGeo());
      await loadRegionStats();
    };
    load();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
})();
</script>
